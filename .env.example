# 复制本文件为 .env 并手动填入真实值。.env 不要提交到 git。

# ---- MySQL（已有数据库，视频流水线复用）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=career_guides_au
MYSQL_CHARSET=utf8mb4

# ---- 大纲生成 LLM 后端选择：claude / openai / deepseek ----
LLM_PROVIDER=claude

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# OpenAI（LLM_PROVIDER=openai 时使用）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=        # 用代理/兼容网关时填，否则留空

# DeepSeek（LLM_PROVIDER=deepseek 时使用，OpenAI 兼容接口）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- Azure 语音合成（TTS）----
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=australiaeast
AZURE_VOICE_ZH=zh-CN-YunyangNeural
AZURE_VOICE_EN=en-AU-NatashaNeural
# 解说风格调优（让语音更像真人）
AZURE_TTS_STYLE=narration-professional
AZURE_TTS_STYLE_DEGREE=1.1
AZURE_TTS_RATE=+6%
AZURE_TTS_EMPHASIZE_NUMBERS=1

# ---- Pexels（B-roll 素材，后期阶段才用）----
PEXELS_API_KEY=

# ---- 本地 Web 管理界面 ----
VIDEO_WEB_HOST=127.0.0.1
VIDEO_WEB_PORT=8000

# ---- 渲染并行度（Remotion --concurrency）----
# 整数或百分比；默认 80%。内存紧张就调低（如 50% 或具体数字 8）。
VIDEO_RENDER_CONCURRENCY=80%
