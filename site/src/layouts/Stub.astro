---
// 极简 noindex 桩页布局：无站点导航/无 CSS 包/无主题脚本，仅 SEO 必需头 + 一行入口。
// 用于非优先语种的职业详情页，单页 ~1KB（对比完整 Base ~34KB），大幅缩减 dist。
interface Alt { locale: string; href: string }
interface Props {
  title: string; name: string; nameEn: string; enHref: string;
  canonicalHref: string; alternates?: Alt[]; xDefault?: string;
}
const { title, name, nameEn, enHref, canonicalHref, alternates = [], xDefault } = Astro.props as Props;
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex,follow" />
    <link rel="canonical" href={abs(canonicalHref)} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.locale === 'zh-CN' ? 'zh-Hans' : a.locale} href={abs(a.href)} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={abs(xDefault)} />}
  </head>
  <body style="font-family:system-ui,-apple-system,sans-serif;max-width:640px;margin:48px auto;padding:0 16px;line-height:1.5">
    <h1 style="font-size:22px;margin:0 0 10px">{name}{name !== nameEn && <span style="color:#888;font-weight:400"> {nameEn}</span>}</h1>
    <p><a href={enHref} style="color:#10b981;font-weight:600">Open the full page in English →</a></p>
  </body>
</html>
