---
import { name, jobHref, seniorSalaryText, seniorMax, trainingMonths, prScore, cardBadges, tr, strings, type Occ, type Locale } from '../lib/data';
interface Props { o: Occ; country: string; locale: Locale; showCountry?: boolean }
const { o, country, locale, showCountry = false } = Astro.props as Props;
const t = strings(locale);
const pay = seniorSalaryText(o), train = tr(o.training_zh, locale), badges = cardBadges(o, locale);
const aiRisk = o.ai?.automation_exposure ?? o.ratings.find((r) => r.dimension === 'ai_risk')?.stars ?? 0;
const search = `${name(o, locale)} ${name(o, 'en')} ${o.name_en} ${o.occ_code} ${o.anzsco_code}`.toLowerCase();
---
<a class="card occ-card"
   href={jobHref(locale, o.slug, country)}
   data-search={search}
   data-cat={o.category}
   data-pr={o.is_migration === 1 ? 1 : 0}
   data-prscore={prScore(o)}
   data-pay={seniorMax(o)}
   data-train={trainingMonths(o)}
   data-score={o.overall_score ?? 0}
   data-airisk={aiRisk}
   data-name={name(o, locale)}>
  <strong>{name(o, locale)}</strong>
  <div class="muted" style="font-size:13px">{o.name_en}</div>
  <div class="badge-row">
    {showCountry && <span class="tag gov">{o.country}</span>}
    {badges.map((b) => <span class={`tag ${b.cls}`} title={b.title}>{b.text}</span>)}
  </div>
  {pay && <div style="margin-top:6px"><span class="amber">{t.seniorPay} {pay}</span></div>}
  {train && <div class="muted" style="font-size:12px;margin-top:4px">🎓 {t.training} · {train}</div>}
</a>
