---
// 一级聚合 URL（多语言前缀）：/{locale}/{category}/{slug} —— 职业本体的各语言版本。
// 仅 JOBS_LOCALES 中非英文的语言（英文为裸 URL /{category}/{slug}）。self-canonical + hreflang + x-default。
import Base from '../../../layouts/Base.astro';
import JobDetail from '../../../components/JobDetail.astro';
import { JOB_SLUGS, FULL_JOB_LOCALES, jobBySlug, jobAlternates, jobHref, strings, tr, name, catSlug, type Locale } from '../../../lib/data';
import { DATA_UPDATED, SITE_NAME } from '../../../lib/site-config';

export function getStaticPaths() {
  const paths: any[] = [];
  for (const locale of FULL_JOB_LOCALES) {
    if (locale === 'en') continue; // 英文走裸 URL
    for (const slug of JOB_SLUGS) paths.push({ params: { locale, category: catSlug(jobBySlug(slug)!.rep.category), slug } });
  }
  return paths;
}
const { locale, slug } = Astro.params as { locale: Locale; category: string; slug: string };
const group = jobBySlug(slug)!;
const rep = group.rep;
const t = strings(locale);
const dispName = name(rep, locale);

const title = `${dispName} — ${t.jTitleG} | ${t.siteTitle}`;
const gist = rep.ai ? tr(rep.ai.verdict_zh, locale) : '';
const description = gist || dispName;

const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
const ld = [{
  '@context': 'https://schema.org', '@type': 'Occupation',
  name: dispName, description: gist || undefined,
  occupationalCategory: rep.anzsco_code || rep.occ_code || undefined,
  url: abs(jobHref(locale, slug)),
}, {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.siteTitle, item: abs(`/${locale}/`) },
    { '@type': 'ListItem', position: 2, name: dispName, item: abs(jobHref(locale, slug)) },
  ],
}, {
  '@context': 'https://schema.org', '@type': 'WebPage', name: title, description,
  dateModified: DATA_UPDATED, inLanguage: locale, publisher: { '@type': 'Organization', name: SITE_NAME },
  mainEntity: { '@type': 'Occupation', name: dispName },
}];
---
<Base title={title} description={description.slice(0, 155)} locale={locale} country={rep.country}
  global={true} alternates={jobAlternates(slug)} xDefault={jobHref('en', slug)} jsonLd={ld}>
  <JobDetail slug={slug} active={null} locale={locale} />
</Base>
