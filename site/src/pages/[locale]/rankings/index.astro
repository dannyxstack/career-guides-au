---
// 全球 AI 榜单 hub（/[locale]/rankings/）：所有榜单均跨国合并、按国家标签呈现。
import Base from '../../../layouts/Base.astro';
import {
  strings, GLOBAL_RANKING_ORDER, rankName, rankSub, rankingList, rankingScorePct, rankingHigherIsRisk,
  name, jobHref, COUNTRY_FLAG, LOCALES, type Locale
} from '../../../lib/data';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const t = strings(locale);
const alternates = LOCALES.map((l) => ({ locale: l, href: `/${l}/rankings/` }));
const lists = GLOBAL_RANKING_ORDER.map((key) => ({ key, items: rankingList(key, undefined as any, 8) })).filter((x) => x.items.length > 0);
---
<Base title={`${t.rkHubTitle} | ${t.siteTitle}`} description={t.rkHubSub} locale={locale} country="" global={true} alternates={alternates}>
  <section class="hero" data-section="hero">
    <h1>{t.rkHubTitle}</h1>
    <p class="hero-value">{t.rkHubSub}</p>
  </section>

  {lists.map(({ key, items }) => (
    <section data-section={`rank-${key.replace(/_/g, '-')}`}>
      <div class="rk-head">
        <div>
          <h2 style="margin:0">{rankName(key, locale)}</h2>
          <p class="muted" style="margin:4px 0 0;font-size:14px">{rankSub(key, locale)}</p>
        </div>
        <a class="btn" href={`/${locale}/rankings/${key.replace(/_/g, '-')}/`}>{t.rkViewFull}</a>
      </div>
      <div class="rank-rows">
        {items.map((o, index) => {
          const score = rankingScorePct(key, o);
          const higherIsRisk = rankingHigherIsRisk(key);
          return (
            <a class="rank-row" href={jobHref(locale, o.slug, o.country)}>
              <div class="rank-title">
                <span class="rank-index">{String(index + 1).padStart(2, '0')}</span>
                <strong>{name(o, locale)}</strong>
                <span class="rank-country"><span class="rank-flag" set:html={COUNTRY_FLAG[o.country]} />{o.country}</span>
              </div>
              <div class="rank-value">
                <span
                  class:list={['rank-track', higherIsRisk ? 'higher-is-risk' : 'higher-is-safe']}
                  role="progressbar"
                  aria-label={`${name(o, locale)} ranking score; higher is ${higherIsRisk ? 'more dangerous' : 'safer'}`}
                  aria-valuemin="0"
                  aria-valuemax="100"
                  aria-valuenow={score}
                >
                  <span class="rank-fill"></span>
                  <span class="rank-rest" style={`left:${score}%`}></span>
                </span>
                <strong class="rank-score">{score}<small>/100</small></strong>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  ))}

  <section data-section="sources">
    <h2>{t.rkSrcTitle}</h2>
    <div class="card muted" style="font-size:13px">
      <p style="margin:0">{t.rkMethod}</p>
    </div>
  </section>

  <style>
    .rk-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; margin: 18px 0 10px; flex-wrap: wrap; }
    .rank-rows { border-top: 1px solid var(--line); }
    .rank-row { display: block; padding: 13px 2px 14px; border-bottom: 1px solid var(--line); color: inherit; text-decoration: none; }
    .rank-row:hover .rank-title strong { color: var(--green); }
    .rank-title { display: grid; grid-template-columns: 28px minmax(0, 1fr) auto; gap: 8px; align-items: center; margin-bottom: 9px; }
    .rank-title strong { min-width: 0; overflow-wrap: anywhere; font-size: 15px; line-height: 1.3; transition: color .15s ease; }
    .rank-index { color: var(--muted); font: 700 11px/1 ui-monospace, SFMono-Regular, Consolas, monospace; }
    .rank-country { display: inline-flex; align-items: center; gap: 5px; color: var(--muted); font-size: 11px; font-weight: 700; }
    .rank-flag { display: inline-flex; }
    .rank-flag :global(svg) { display: block; width: 18px; height: 12px; border-radius: 2px; box-shadow: 0 0 0 1px var(--line); }
    .rank-value { display: grid; grid-template-columns: minmax(0, 1fr) 58px; gap: 12px; align-items: center; padding-left: 36px; }
    .rank-track { position: relative; display: block; height: 9px; overflow: hidden; border-radius: 5px; background: var(--line); }
    .rank-fill { position: absolute; inset: 0; border-radius: inherit; }
    .higher-is-risk .rank-fill { background: linear-gradient(90deg, var(--green) 0%, #d8a522 56%, #c2413b 100%); }
    .higher-is-safe .rank-fill { background: linear-gradient(90deg, #c2413b 0%, #d8a522 44%, var(--green) 100%); }
    .rank-rest { position: absolute; top: 0; right: 0; bottom: 0; background: var(--line); transition: left .2s ease; }
    .rank-score { color: var(--ink); font: 750 14px/1 ui-monospace, SFMono-Regular, Consolas, monospace; text-align: right; }
    .rank-score small { color: var(--muted); font-size: 10px; font-weight: 600; }
    @media (max-width: 520px) {
      .rank-title { grid-template-columns: 24px minmax(0, 1fr); }
      .rank-country { grid-column: 2; }
      .rank-value { padding-left: 32px; grid-template-columns: minmax(0, 1fr) 54px; gap: 9px; }
    }
  </style>
</Base>
