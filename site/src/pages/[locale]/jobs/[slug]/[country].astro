---
// 二级区域 URL（多语言前缀）：/{locale}/jobs/{slug}/{country} —— 各语言 × 各国的国家数据页。
// 仅 JOBS_LOCALES 中非英文语言。独立可抓取，self-canonical + hreflang + x-default。
import Base from '../../../../layouts/Base.astro';
import JobDetail from '../../../../components/JobDetail.astro';
import { JOB_SLUGS, JOBS_LOCALES, jobBySlug, jobAlternates, jobHref, strings, tr, name, summary, currencyOf, countryTitleName, type Locale } from '../../../../lib/data';

export function getStaticPaths() {
  const paths: any[] = [];
  for (const locale of JOBS_LOCALES) {
    if (locale === 'en') continue;
    for (const slug of JOB_SLUGS) {
      const g = jobBySlug(slug)!;
      for (const o of g.countries) paths.push({ params: { locale, slug, country: o.country }, props: { o } });
    }
  }
  return paths;
}
const { locale, slug, country } = Astro.params as { locale: Locale; slug: string; country: string };
const { o } = Astro.props as any;
const t = strings(locale);
const dispName = name(o, locale);
const cName = countryTitleName(country, locale);

const title = `${dispName} · ${cName} — ${t.jTitleC} | ${t.siteTitle}`;
const description = (summary(o, locale) || '').slice(0, 155);

const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
const sal = o.salaries.filter((s: any) => s.min || s.max).map((s: any) => Number(s.max || s.min));
const salMin = sal.length ? Math.min(...o.salaries.filter((s: any) => s.min).map((s: any) => Number(s.min))) : null;
const salMax = sal.length ? Math.max(...sal) : null;
const ld = [{
  '@context': 'https://schema.org', '@type': 'Occupation',
  name: dispName, description: summary(o, locale) || undefined,
  occupationalCategory: (o.anzsco_code || o.occ_code) ? `${o.occ_code_type} ${o.anzsco_code || o.occ_code}` : undefined,
  occupationLocation: { '@type': 'Country', name: cName },
  ...(salMax ? { estimatedSalary: { '@type': 'MonetaryAmountDistribution', name: 'base', currency: currencyOf(country),
    median: salMax && salMin ? Math.round((salMin + salMax) / 2) : salMax, percentile10: salMin, percentile90: salMax } } : {}),
  educationRequirements: o.education.map((e: any) => tr(e.stage, locale)).filter(Boolean).join('; ') || undefined,
  url: abs(jobHref(locale, slug, country)),
}, {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.siteTitle, item: abs(`/${locale}/`) },
    { '@type': 'ListItem', position: 2, name: dispName, item: abs(jobHref(locale, slug)) },
    { '@type': 'ListItem', position: 3, name: cName, item: abs(jobHref(locale, slug, country)) },
  ],
}];
---
<Base title={title} description={description} locale={locale} country={country}
  global={true} alternates={jobAlternates(slug, country)} xDefault={jobHref('en', slug, country)} jsonLd={ld}>
  <JobDetail slug={slug} active={country} locale={locale} />
</Base>
