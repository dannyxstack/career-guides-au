---
// 全球「关于」页（/[locale]/about/）。国家页仍有各自本地化 about。
import Base from '../../../layouts/Base.astro';
import { strings, dimLabel, dimDesc, COUNTRIES, countryName, LOCALES, type Locale } from '../../../lib/data';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}
const { locale } = Astro.params as { locale: Locale };
const t = strings(locale);
const alternates = LOCALES.map((l) => ({ locale: l, href: `/${l}/about/` }));

const DIM_ORDER = [
  'income_level', 'job_demand', 'future_prospect', 'pr_friendliness',
  'ai_risk', 'competition', 'work_intensity',
  'learning_difficulty', 'learning_duration', 'certification_difficulty', 'pr_difficulty',
];
---
<Base title={`${t.abTitle}｜AI Career Graph`} description={t.abLead} locale={locale} country="" global={true} alternates={alternates}>
  <section class="hero" data-section="hero">
    <h1>{t.abTitle}</h1>
    <p class="hero-value">{t.abLead}</p>
  </section>

  <section class="about" data-section="about">
    <div data-section="who-we-are">
      <h2>{t.abS1h}</h2>
      <p>{t.abS1}</p>
    </div>
    <div data-section="problem">
      <h2>{t.abS2h}</h2>
      <p>{t.abS2a}</p>
      <p>{t.abS2b}</p>
    </div>
    <div data-section="how-we-analyse">
      <h2>{t.abS3h}</h2>
      <p>{t.abS3a}</p>
      <p>{t.abS3b}</p>
    </div>

    <div data-section="dimensions">
      <h2>{t.abS7h}</h2>
      <p>{t.abS7lead}</p>
      <dl class="dims">
        {DIM_ORDER.map((dim) => (
          <div class="dim-row">
            <dt>{dimLabel(dim, locale)}</dt>
            <dd>{dimDesc(dim, locale)}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div data-section="sources-methodology">
      <h2>{t.abS4h}</h2>
      <p>{t.abS4a}</p>
      <p>{t.abS4b}</p>
    </div>
    <div data-section="ai-exposure-methodology">
      <h2>{t.abAiExpH}</h2>
      <p>{t.abAiExpA}</p>
      <p>{t.abAiExpB}</p>
    </div>
    <div data-section="what-we-dont-do">
      <h2>{t.abS5h}</h2>
      <p>{t.abS5}</p>
    </div>
    <div data-section="whats-next">
      <h2>{t.abS6h}</h2>
      <p>{t.abS6}</p>
    </div>

    <div data-section="country-sources">
      <h2>{t.abCountrySrcH}</h2>
      <p class="muted" style="font-size:13px">{t.abCountrySrcNote}</p>
      <ul class="src-links">
        {COUNTRIES.map((cc) => (
          <li><a href={`/${cc}/${locale}/`}>{countryName(cc, locale)} {t.abCountryGuide}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <style>
    .about { display: flex; flex-direction: column; gap: 10px; max-width: 760px; }
    .about p { line-height: 1.7; margin: 8px 0; }
    .src-links { margin: 8px 0 0; padding-left: 18px; font-size: 13px; }
    .src-links li { margin: 4px 0; }
    .src-links a { color: var(--green); text-decoration: underline; }
    .dims { margin: 10px 0 0; display: flex; flex-direction: column; gap: 6px; }
    .dim-row { display: grid; grid-template-columns: 130px 1fr; gap: 12px; align-items: baseline; padding: 6px 0; border-bottom: 1px solid var(--line); }
    .dim-row dt { font-weight: 600; }
    .dim-row dd { margin: 0; color: var(--muted); line-height: 1.6; }
    @media (max-width: 560px) { .dim-row { grid-template-columns: 1fr; gap: 2px; } }
  </style>
</Base>
