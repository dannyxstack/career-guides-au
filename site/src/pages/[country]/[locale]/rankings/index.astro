---
import Base from '../../../../layouts/Base.astro';
import OccCard from '../../../../components/OccCard.astro';
import { COUNTRIES, LOCALES, strings, RANKING_ORDER, rankName, rankSub, rankingList, sourcesBody, type Locale } from '../../../../lib/data';

export function getStaticPaths() {
  return COUNTRIES.flatMap((country) => LOCALES.map((locale) => ({ params: { country, locale } })));
}
const { country, locale } = Astro.params as { country: string; locale: Locale };
const t = strings(locale);
const alternates = LOCALES.map((l) => ({ locale: l, href: `/${country}/${l}/rankings/` }));
const lists = RANKING_ORDER.map((key) => ({ key, items: rankingList(key, country, 6) })).filter((x) => x.items.length > 0);
---
<Base title={t.rkHubTitle} description={t.rkHubSub} locale={locale} country={country} alternates={alternates}>
  <section class="hero" data-section="hero">
    <h1>{t.rkHubTitle}</h1>
    <p class="hero-value">{t.rkHubSub}</p>
  </section>

  {lists.map(({ key, items }) => (
    <section data-section={`rank-${key.replace(/_/g, '-')}`}>
      <div class="rk-head">
        <div>
          <h2 style="margin:0">{rankName(key, locale)}</h2>
          <p class="muted" style="margin:4px 0 0;font-size:14px">{rankSub(key, locale)}</p>
        </div>
        <a class="btn" href={`/${country}/${locale}/rankings/${key.replace(/_/g, '-')}/`}>{t.rkViewFull}</a>
      </div>
      <div class="grid grid-cards">
        {items.map((o) => <OccCard o={o} country={country} locale={locale} />)}
      </div>
    </section>
  ))}

  <section data-section="sources">
    <h2>{t.rkSrcTitle}</h2>
    <div class="card muted" style="font-size:13px">
      <p style="margin:0">{t.rkMethod}</p>
      <p style="margin:6px 0 0">{sourcesBody(country, locale)}</p>
    </div>
  </section>

  <style>
    .rk-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; margin: 18px 0 10px; flex-wrap: wrap; }
  </style>
</Base>
