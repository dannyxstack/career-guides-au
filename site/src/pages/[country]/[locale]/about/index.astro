---
import Base from '../../../../layouts/Base.astro';
import { COUNTRIES, LOCALES, strings, sourcesBody, AU_SOURCE_LINKS, dimLabel, dimDesc, type Locale } from '../../../../lib/data';

// 11 个评分维度的展示顺序：正向（越高越好）在前，负向（越低越好）在后
const DIM_ORDER = [
  'income_level', 'job_demand', 'future_prospect', 'pr_friendliness',
  'ai_risk', 'competition', 'work_intensity',
  'learning_difficulty', 'learning_duration', 'certification_difficulty', 'pr_difficulty',
];

export function getStaticPaths() {
  return COUNTRIES.flatMap((country) => LOCALES.map((locale) => ({ params: { country, locale } })));
}
const { country, locale } = Astro.params as { country: string; locale: Locale };
const t = strings(locale);
const alternates = LOCALES.map((l) => ({ locale: l, href: `/${country}/${l}/about/` }));
const zh = locale === 'zh-CN';

const C = zh ? {
  title: '关于 AI Career Graph',
  lead: 'AI Career Graph 是一个面向 AI 时代的职业图谱项目——不只介绍职业，更帮你判断：哪些工作会被 AI 压缩，哪些会被放大，未来 5 年该补什么技能，以及可以转向哪些更稳的职业。',
  s1h: '我们是谁',
  s1: ['AI Career Graph 是一个面向 AI 时代的职业图谱项目，帮助学生、转行者、移民申请人和职场人理解不同职业的风险、机会和转型路径。'],
  s2h: '我们解决什么问题',
  s2: ['我们不是简单地问「AI 会不会取代某个职业」，而是拆解这个职业中哪些任务会被自动化，哪些任务会被增强，哪些能力仍然需要人类承担。',
       '我们把职业分成 6 大类（AI 高替代 / AI 增强 / 强执照 / 强现场 / 强人际信任 / 强监管），并为每个职业标注：AI 会接管的任务、AI 会增强的任务、人类护城河、入门是否变窄、AI 时代升级路线，以及风险高时可转向的相邻职业。'],
  s3h: '我们如何分析职业',
  s3: ['每个职业按多个维度评分：AI 自动化风险、人类护城河、入门岗位变窄、AI 增强空间、薪资、需求、执照、移民友好度。',
       '「AI 职业图谱」用二维矩阵（AI 自动化程度 × 人类责任/现场依赖）把职业分布可视化；「AI 时代职业榜单」按这些维度给出多个榜单，由公开排序公式自动计算、可复现，不靠人工指定。'],
  s7h: '11 个评分维度怎么看',
  s7lead: '每个职业按以下 11 个维度打分（10 分制，详情页展示为星级）。维度分正向与负向两类：正向越高越好，负向越低越好。综合评分会把负向维度反向后再取平均。',
  s4h: '数据来源与方法',
  s4: ['我们综合使用公开数据：招聘平台薪资区间、各国官方职业分类（如 ANZSCO / NOC）、移民主管部门职业清单与就业机构的需求预测，并据此建立职业评分模型。',
       '所有薪资、评分与移民信息均为估算与参考，定期更新，具体以官方最新发布为准。'],
  s5h: '我们不做什么',
  s5: ['本站不出售课程，不提供移民、法律、财务建议，不保证就业或签证结果。所有内容仅为信息参考。'],
  s6h: '未来计划',
  s6: ['我们从澳洲开始，逐步扩展到新西兰、加拿大、美国、英国等国家，持续完善每个职业的 AI 时代分析与职业路径数据。'],
  srch: '数据来源',
} : {
  title: 'About AI Career Graph',
  lead: 'AI Career Graph is a career-mapping project for the AI era — beyond describing jobs, it helps you judge which roles get compressed by AI, which get amplified, what to build over the next 5 years, and which more durable roles you can pivot to.',
  s1h: 'Who we are',
  s1: ['AI Career Graph is a career-mapping project for the AI era, helping students, career changers, migration applicants and working professionals understand the risks, opportunities and transition paths of different occupations.'],
  s2h: 'The problem we solve',
  s2: ['We don’t simply ask “will AI replace this job?” — we break down which tasks within a job get automated, which get amplified, and which capabilities still require humans.',
       'We group occupations into 6 clusters (high AI exposure / AI-augmented / licensed / on-site / human-trust / regulated) and annotate each: tasks AI will take over, tasks AI will augment, the human moat, whether entry-level narrows, an AI-era upgrade path, and adjacent careers to pivot to if risk is high.'],
  s3h: 'How we analyse occupations',
  s3: ['Each occupation is scored across several dimensions: AI automation risk, human moat, entry-level narrowing, AI-augmentation upside, salary, demand, licensing and migration friendliness.',
       'The AI Career Map visualises occupations on a 2D matrix (automation exposure × human accountability/on-site). The AI-era rankings give several lists across these dimensions, computed by transparent, reproducible formulas — not hand-picked.'],
  s7h: 'The 11 rating dimensions',
  s7lead: 'Each occupation is scored across the following 11 dimensions (10-point scale, shown as stars on detail pages). Dimensions are either positive or negative: for positive ones higher is better, for negative ones lower is better. The overall score averages them after inverting the negative dimensions.',
  s4h: 'Data sources & methodology',
  s4: ['We aggregate public data: job-platform salary ranges, official occupation classifications (e.g. ANZSCO / NOC), migration authorities’ occupation lists and employment agencies’ demand forecasts, and build a scoring model on top.',
       'All salaries, scores and migration details are estimates and indicative only, updated periodically — always rely on the latest official sources.'],
  s5h: 'What we don’t do',
  s5: ['We don’t sell courses, and we don’t provide migration, legal or financial advice, nor guarantee employment or visa outcomes. All content is for information only.'],
  s6h: 'What’s next',
  s6: ['Starting with Australia, we are gradually expanding to New Zealand, Canada, the United States, the United Kingdom and more, continuing to refine the AI-era analysis and career-path data for each occupation.'],
  srch: 'Data sources',
};
---
<Base title={`${C.title}｜${t.siteTitle}`} description={C.lead} locale={locale} country={country} alternates={alternates}>
  <section class="hero" data-section="hero">
    <h1>{C.title}</h1>
    <p class="hero-value">{C.lead}</p>
  </section>

  <section class="about" data-section="about">
    {[[C.s1h, C.s1, 'who-we-are'], [C.s2h, C.s2, 'problem'], [C.s3h, C.s3, 'how-we-analyse']].map(([h, paras, key]) => (
      <div data-section={key}>
        <h2>{h}</h2>
        {(paras as string[]).map((p) => <p>{p}</p>)}
      </div>
    ))}

    <div data-section="dimensions">
      <h2>{C.s7h}</h2>
      <p>{C.s7lead}</p>
      <dl class="dims">
        {DIM_ORDER.map((dim) => (
          <div class="dim-row">
            <dt>{dimLabel(dim, locale)}</dt>
            <dd>{dimDesc(dim, locale)}</dd>
          </div>
        ))}
      </dl>
    </div>

    {[[C.s4h, C.s4, 'sources-methodology'], [C.s5h, C.s5, 'what-we-dont-do'], [C.s6h, C.s6, 'whats-next']].map(([h, paras, key]) => (
      <div data-section={key}>
        <h2>{h}</h2>
        {(paras as string[]).map((p) => <p>{p}</p>)}
      </div>
    ))}
    <div data-section="sources">
      <h2>{C.srch}</h2>
      <p class="muted" style="font-size:13px">{sourcesBody(country, locale)}</p>
      {country === 'AU' && (
        <ul class="src-links">
          {AU_SOURCE_LINKS.map((s) => (
            <li><a href={s.url} target="_blank" rel="noopener nofollow">{s.label[zh ? 'zh-CN' : 'en']}</a></li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <style>
    .about { display: flex; flex-direction: column; gap: 10px; max-width: 760px; }
    .about p { line-height: 1.7; margin: 8px 0; }
    .src-links { margin: 8px 0 0; padding-left: 18px; font-size: 13px; }
    .src-links li { margin: 4px 0; }
    .src-links a { color: var(--green); text-decoration: underline; }
    .dims { margin: 10px 0 0; display: flex; flex-direction: column; gap: 6px; }
    .dim-row { display: grid; grid-template-columns: 130px 1fr; gap: 12px; align-items: baseline; padding: 6px 0; border-bottom: 1px solid var(--border, #2a2a2a); }
    .dim-row dt { font-weight: 600; }
    .dim-row dd { margin: 0; color: var(--muted, #9aa0a6); line-height: 1.6; }
    @media (max-width: 560px) { .dim-row { grid-template-columns: 1fr; gap: 2px; } }
  </style>
</Base>
