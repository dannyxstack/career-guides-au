---
import Base from '../../../layouts/Base.astro';
import OccCard from '../../../components/OccCard.astro';
import { COUNTRIES, LOCALES, byCategory, occByCountry, categoriesFor, name, strings,
  COMPARE_PAIRS, pairKey, getBySlug, bestMigration, bestIncome, fastestEntry, countryName, countryTitleName, type Locale } from '../../../lib/data';

export function getStaticPaths() {
  return COUNTRIES.flatMap((country) => LOCALES.map((locale) => ({ params: { country, locale } })));
}
const { country, locale } = Astro.params as { country: string; locale: Locale };
const t = strings(locale);
const alternates = LOCALES.map((l) => ({ locale: l, href: `/${country}/${l}/` }));

const occs = occByCountry(country);
const cats = categoriesFor(country);
// 数据点条
const stats = [
  `${occs.length}+ careers`,
  `${cats.length} career categories`,
  'Salary / PR / training / demand',
  `${countryName(country, locale)}`,
];
// 筛选 chips：值即 data-* 过滤键
const FILTERS = [
  { key: 'pr', label: t.fPR }, { key: 'high', label: t.fHigh }, { key: 'short', label: t.fShort },
  { key: 'cat:Healthcare & Care', label: 'Healthcare' },
  { key: 'cat:Trades & Construction', label: 'Trades' },
  { key: 'cat:IT & Digital', label: 'IT' },
];
const SORTS = [
  { key: 'score', label: t.sortOverall }, { key: 'pay', label: t.sortPay },
  { key: 'train', label: t.sortTrain }, { key: 'pr', label: t.sortPR },
];
const mig = bestMigration(6, country), inc = bestIncome(6, country), fast = fastestEntry(6, country);
const showCompare = country === 'AU' && COMPARE_PAIRS.length > 0;

const ctn = countryTitleName(country, locale);
const metaTitle = locale === 'zh-CN'
  ? `${ctn}AI职业图谱｜薪资、移民、AI替代风险与未来职业路径`
  : `AI Career Map for ${ctn} | Salary, Migration, AI Risk & Future Routes`;
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
const ld = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: t.siteTitle, description: t.heroValue,
    url: abs(`/${country}/${locale}/`), inLanguage: locale },
  { '@context': 'https://schema.org', '@type': 'Organization', name: t.siteTitle, url: abs(`/${country}/${locale}/`) },
];
---
<Base title={metaTitle} description={t.homeMetaDesc} locale={locale} country={country} alternates={alternates} jsonLd={ld}>
  <!-- Hero -->
  <section class="hero" data-section="hero">
    <h1>{t.siteTitle}</h1>
    <p class="hero-value">{t.heroValue}</p>
    <div class="stat-row">
      {stats.map((s) => <div class="stat">{s}</div>)}
    </div>
    <div class="cta-row">
      <a class="btn primary" href="#all-careers">{t.ctaBrowse}</a>
      <a class="btn" href="#compare">{t.ctaCompare}</a>
    </div>
  </section>

  <!-- Search / filters / sort -->
  <section class="controls" id="controls" data-section="controls">
    <div class="ac-wrap">
      <input id="q" type="search" placeholder={t.searchPh} autocomplete="off" aria-expanded="false" data-noresult={t.noResult} />
      <div id="ac" class="ac" hidden></div>
    </div>
    <div class="chips">
      {FILTERS.map((f) => <button class="chip" data-filter={f.key} type="button">{f.label}</button>)}
    </div>
    <label class="sort">
      {t.sortBy}:
      <select id="sort">
        {SORTS.map((s) => <option value={s.key}>{s.label}</option>)}
      </select>
    </label>
  </section>

  <!-- AI 职业图谱入口 -->
  <section data-section="ai-graph-promo">
    <a class="card ai-promo" href={`/${country}/${locale}/ai-graph/`}>
      <h2 style="margin:0 0 6px">🧭 {t.homeAgTitle}</h2>
      <p class="muted" style="margin:0 0 8px;font-size:14px">{t.homeAgBody}</p>
      <span style="color:var(--green);font-weight:700">{t.agViewGraph}</span>
    </a>
  </section>
  <section style="margin-top:22px" data-section="rankings-promo">
    <a class="card ai-promo" href={`/${country}/${locale}/rankings/`}>
      <h2 style="margin:0 0 6px">🏆 {t.homeRkTitle}</h2>
      <p class="muted" style="margin:0 0 8px;font-size:14px">{t.homeRkBody}</p>
      <span style="color:var(--green);font-weight:700">{t.rkViewFull}</span>
    </a>
  </section>

  <!-- Featured comparisons -->
  {showCompare && (
    <section id="compare" data-section="compare">
      <h2>{t.compare}</h2>
      <div class="grid grid-cards">
        {COMPARE_PAIRS.map(([a, b]) => {
          const oa = getBySlug(a)!, ob = getBySlug(b)!;
          return (
            <a class="card" href={`/${country}/${locale}/compare/${pairKey(a, b)}/`}>
              <strong>{name(oa, locale)} {t.vs} {name(ob, locale)}</strong>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <!-- Curated sections -->
  <section data-section="best-migration">
    <h2>{t.secMigration}</h2>
    <div class="grid grid-cards">{mig.map((o) => <OccCard o={o} country={country} locale={locale} />)}</div>
  </section>
  <section data-section="best-income">
    <h2>{t.secIncome}</h2>
    <div class="grid grid-cards">{inc.map((o) => <OccCard o={o} country={country} locale={locale} />)}</div>
  </section>
  <section data-section="fastest-entry">
    <h2>{t.secFast}</h2>
    <div class="grid grid-cards">{fast.map((o) => <OccCard o={o} country={country} locale={locale} />)}</div>
  </section>

  <!-- Categories quick-nav -->
  <section data-section="categories">
    <h2>{t.secCats}</h2>
    <div class="chips">
      {cats.map((c) => (
        <button class="chip" type="button" data-filter={`cat:${c}`} data-scroll>{c} <span class="muted">({byCategory(c, country).length})</span></button>
      ))}
    </div>
  </section>

  <!-- All careers (filter/sort target) -->
  <section id="all-careers" data-section="all-careers">
    <h2>{t.allCareers} <span class="muted" id="count" style="font-size:14px"></span></h2>
    <div class="grid grid-cards" id="all-grid">
      {occs.map((o) => <OccCard o={o} country={country} locale={locale} />)}
    </div>
    <p class="muted" id="empty" style="display:none">{t.noResult}</p>
  </section>

  <script is:inline define:vars={{ HIGH: 130000, SHORT: 12 }}>
    const grid = document.getElementById('all-grid');
    const cards = Array.from(grid.children);
    const q = document.getElementById('q');
    const sortSel = document.getElementById('sort');
    const chips = Array.from(document.querySelectorAll('.chip[data-filter]'));
    const active = new Set();
    const num = (el, k) => parseFloat(el.getAttribute(k)) || 0;

    function apply() {
      const term = (q.value || '').trim().toLowerCase();
      let shown = 0;
      cards.forEach((c) => {
        let ok = !term || c.getAttribute('data-search').includes(term);
        for (const f of active) {
          if (f === 'pr') ok = ok && num(c, 'data-pr') === 1;
          else if (f === 'high') ok = ok && num(c, 'data-pay') >= HIGH;
          else if (f === 'short') ok = ok && num(c, 'data-train') <= SHORT;
          else if (f.startsWith('cat:')) ok = ok && c.getAttribute('data-cat') === f.slice(4);
        }
        c.style.display = ok ? '' : 'none';
        if (ok) shown++;
      });
      document.getElementById('count').textContent = '(' + shown + ')';
      document.getElementById('empty').style.display = shown ? 'none' : 'block';
    }
    function sortCards() {
      const k = sortSel.value;
      const dir = k === 'train' ? 1 : -1; // 培训时长升序，其余降序
      const attr = { score: 'data-score', pay: 'data-pay', train: 'data-train', pr: 'data-prscore' }[k];
      cards.slice().sort((a, b) => (num(a, attr) - num(b, attr)) * dir).forEach((c) => grid.appendChild(c));
    }
    function syncChips() {
      chips.forEach((c) => c.classList.toggle('on', active.has(c.getAttribute('data-filter'))));
    }
    // 搜索框下拉实时结果（最多 10 条）
    const ac = document.getElementById('ac');
    function renderAC() {
      const term = (q.value || '').trim().toLowerCase();
      ac.innerHTML = '';
      if (!term) { ac.hidden = true; q.setAttribute('aria-expanded', 'false'); return; }
      const matches = cards.filter((c) => c.getAttribute('data-search').includes(term)).slice(0, 10);
      if (!matches.length) {
        const d = document.createElement('div'); d.className = 'ac-empty'; d.textContent = q.dataset.noresult || '';
        ac.appendChild(d); ac.hidden = false; q.setAttribute('aria-expanded', 'true'); return;
      }
      matches.forEach((c) => {
        const a = document.createElement('a'); a.href = c.getAttribute('href'); a.className = 'ac-item';
        const nm = document.createElement('span'); nm.className = 'ac-name'; nm.textContent = c.getAttribute('data-name');
        const meta = document.createElement('span'); meta.className = 'ac-meta';
        const pay = Number(c.getAttribute('data-pay')) || 0;
        meta.textContent = c.getAttribute('data-cat') + (pay ? ' · $' + pay.toLocaleString('en-US') : '');
        a.appendChild(nm); a.appendChild(meta); ac.appendChild(a);
      });
      ac.hidden = false; q.setAttribute('aria-expanded', 'true');
    }
    function onSearch() { apply(); renderAC(); }
    q.addEventListener('input', onSearch);
    q.addEventListener('compositionend', onSearch); // 中文输入法选词确认后再过滤
    q.addEventListener('search', onSearch);         // 清空(x)按钮
    q.addEventListener('focus', renderAC);
    q.addEventListener('blur', () => setTimeout(() => { ac.hidden = true; }, 150));
    q.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') { const f = ac.querySelector('.ac-item'); if (f) { window.location.href = f.href; } else apply(); }
      else if (e.key === 'Escape') { ac.hidden = true; }
    });
    sortSel.addEventListener('change', () => { sortCards(); apply(); });
    chips.forEach((ch) => ch.addEventListener('click', () => {
      const f = ch.getAttribute('data-filter');
      active.has(f) ? active.delete(f) : active.add(f);
      syncChips();
      apply();
      if (ch.hasAttribute('data-scroll')) document.getElementById('all-careers').scrollIntoView({ behavior: 'smooth' });
    }));
    apply();
  </script>
</Base>
