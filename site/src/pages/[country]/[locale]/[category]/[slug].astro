---
import Base from '../../../../layouts/Base.astro';
import RatingRadar from '../../../../components/RatingRadar.astro';
import PollBlock from '../../../../components/PollBlock.astro';
import { COUNTRIES, LOCALES, occupations, catSlug, name, summary, strings, dimLabel, tr,
  radarLabels, radarValues, money, currencyOf, sourcesBody, getBySlug,
  migRestrictedOccOf, migRestrictedNoteOf, nonMigVisaOf, sameOccAbroad,
  countryName, COUNTRY_FLAG,
  clusterField, clusterColor, countryTitleName, disType, disLevel, type Locale } from '../../../../lib/data';

export function getStaticPaths() {
  const paths: any[] = [];
  for (const country of COUNTRIES)
    for (const locale of LOCALES)
      for (const o of occupations.filter((x) => x.country === country))
        paths.push({ params: { country, locale, category: catSlug(o.category), slug: o.slug }, props: { o } });
  return paths;
}
const { country, locale, slug } = Astro.params as { country: string; locale: Locale; slug: string };
const { o } = Astro.props as any;
const t = strings(locale);
const cur = o.currency || currencyOf(country);
const z = o.i18n['zh-CN'] || {};
const i = {
  name: name(o, locale), summary: summary(o, locale),
  forecast_note: tr(z.forecast_note, locale), trend_summary: tr(z.trend_summary, locale),
};
const alternates = LOCALES.map((l) => ({ locale: l, href: `/${country}/${l}/${catSlug(o.category)}/${o.slug}/` }));
// 同名职业在其它国家的页面（移民到其它国家的入口）
const abroad = sameOccAbroad(o);
const radar = [{ name: name(o, locale), color: '#10b981', values: radarValues(o) }];

// ---- schema.org 结构化数据 ----
const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
const sal = o.salaries.filter((s: any) => s.min || s.max).map((s: any) => Number(s.max || s.min));
const salMin = sal.length ? Math.min(...o.salaries.filter((s: any) => s.min).map((s: any) => Number(s.min))) : null;
const salMax = sal.length ? Math.max(...sal) : null;
const ld: any[] = [{
  '@context': 'https://schema.org', '@type': 'Occupation',
  name: name(o, locale), description: summary(o, locale),
  occupationalCategory: (o.anzsco_code || o.occ_code) ? `${o.occ_code_type} ${o.anzsco_code || o.occ_code}` : undefined,
  occupationLocation: { '@type': 'Country', name: countryTitleName(country, 'en') },
  ...(salMax ? { estimatedSalary: { '@type': 'MonetaryAmountDistribution', name: 'base', currency: currencyOf(country),
    median: salMax && salMin ? Math.round((salMin + salMax) / 2) : salMax, percentile10: salMin, percentile90: salMax } } : {}),
  educationRequirements: o.education.map((e: any) => tr(e.stage, locale)).filter(Boolean).join('; ') || undefined,
  skills: (o.growth_areas || []).join(', ') || undefined,
  url: abs(`/${country}/${locale}/${catSlug(o.category)}/${o.slug}/`),
}, {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.siteTitle, item: abs(`/${country}/${locale}/`) },
    { '@type': 'ListItem', position: 2, name: o.category, item: abs(`/${country}/${locale}/`) + `#cat-${catSlug(o.category)}` },
    { '@type': 'ListItem', position: 3, name: name(o, locale), item: abs(`/${country}/${locale}/${catSlug(o.category)}/${o.slug}/`) },
  ],
}];
if (o.faqs?.length) ld.push({
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: o.faqs.map((f: any) => ({ '@type': 'Question', name: tr(f.question, locale),
    acceptedAnswer: { '@type': 'Answer', text: tr(f.answer, locale) } })),
});
---
<Base title={locale === 'zh-CN'
    ? `${countryTitleName(country, locale)}${name(o, locale)}：AI替代风险、薪资、移民与未来技能｜AI Career Graph`
    : `${o.name_en} in ${countryTitleName(country, locale)}: AI Risk, Salary, Migration & Career Path | AI Career Graph`}
  description={summary(o, locale).slice(0, 150)} locale={locale} country={country} alternates={alternates} jsonLd={ld}>
  <a class="muted" href={`/${country}/${locale}/`}>{t.backHome}</a>
  <h1>{name(o, locale)} <span class="muted" style="font-size:18px">{o.name_en}</span></h1>
  <p>
    <span class="tag">{t.code}: {o.anzsco_code || '—'}（{o.occ_code_type}）</span>
    {o.is_migration === 1 ? <span class="tag mig">{t.migOcc}</span>
      : o.is_migration === 2 ? <span class="tag warn">{migRestrictedOccOf(country, locale)}</span>
      : <span class="tag">{t.nonMig}</span>}
    {o.overall_score != null && <span class="tag amber">{t.overall} {o.overall_score}/10</span>}
  </p>
  <p>{summary(o, locale)}</p>

  <section data-section="ratings">
    <h2>{t.ratings}{o.overall_score != null ? ` · ${t.overall} ${o.overall_score}/10` : ''}<span class="info" data-tip={t.overallTip}>i</span></h2>
    <RatingRadar labels={radarLabels(locale)} series={radar} max={10} />
  </section>

  {o.ai && (
    <section class="ai-block" data-section="ai">
      <h2 data-section="ai-title">{t.aiTitle.replace('{name}', i.name)}</h2>
      {/* 1. 结论 */}
      <div class="card ai-verdict" data-section="ai-verdict">
        <span class={`tag ${o.ai.verdict_type === 'compressed' ? 'bad' : o.ai.verdict_type === 'amplified' ? 'mig' : 'warn'}`}>
          {o.ai.verdict_type === 'compressed' ? t.vCompressed : o.ai.verdict_type === 'amplified' ? t.vAmplified : t.vMixed}
        </span>
        <p style="margin:8px 0 0">{tr(o.ai.verdict_zh, locale)}</p>
      </div>
      {/* 1.4 学术 AI Exposure 指数（AIOE · Felten 等），区别于上方大模型判断 */}
      {o.ai.aioe_pct != null && (
        <div class="card" data-section="ai-aioe" style="border-left:4px solid var(--green)">
          <strong>{locale === 'zh-CN' ? 'AI 暴露指数（学术 · AIOE）' : 'AI Exposure Index (AIOE)'}</strong>
          <div style="display:flex;align-items:center;gap:12px;margin:10px 0 6px">
            <div style="font-size:30px;font-weight:700;line-height:1">{o.ai.aioe_pct}<span style="font-size:15px;font-weight:500;color:var(--muted)"> / 100</span></div>
            <div style="flex:1">
              <div style="height:10px;border-radius:6px;background:var(--border);overflow:hidden">
                <div style={`height:100%;width:${o.ai.aioe_pct}%;background:linear-gradient(90deg,#22c55e,#f59e0b,#ef4444)`}></div>
              </div>
              <p class="muted" style="margin:6px 0 0;font-size:13px">{locale === 'zh-CN' ? `暴露程度高于约 ${o.ai.aioe_pct}% 的职业（百分位，越高越易受 AI 影响）` : `More exposed than about ${o.ai.aioe_pct}% of occupations (percentile; higher = more exposed to AI)`}</p>
            </div>
          </div>
          <p class="muted" style="margin:6px 0 0;font-size:12px">
            {locale === 'zh-CN'
              ? `方法：Felten–Raj–Seamans AIOE（10 项 AI 能力 × O*NET 52 项职业能力加权）。${o.ai.aioe_method === 'crosswalk' ? `经 ISCO-08 ${String(o.ai.aioe_soc || '').replace('ISCO:', '')} 跨分类对应到美国 SOC（仅供参考）` : `直接对应美国 SOC ${o.ai.aioe_soc}`}。区别于上方基于大模型的风险判断。`
              : `Method: Felten–Raj–Seamans AIOE (10 AI applications × 52 O*NET abilities, weighted). ${o.ai.aioe_method === 'crosswalk' ? `Mapped to U.S. SOC via ISCO-08 ${String(o.ai.aioe_soc || '').replace('ISCO:', '')} (indicative)` : `Direct match to U.S. SOC ${o.ai.aioe_soc}`}. Distinct from the LLM-based assessment above.`}
          </p>
        </div>
      )}
      {/* 1.5 已经在替代该职业的 AI 工具/产品/研究/新闻 */}
      {o.ai.disruptors && o.ai.disruptors.length > 0 && (
        <div class="card" data-section="ai-disruptors">
          <strong class="amber">🤖 {t.aiDisrupt}</strong>
          <ul class="disruptors">
            {o.ai.disruptors.map((d: any) => (
              <li class="dis-item">
                <div class="dis-head">
                  {d.url
                    ? <a class="dis-name" href={d.url} target="_blank" rel="noopener nofollow">{d.name}</a>
                    : <span class="dis-name">{d.name}</span>}
                  <span class="tag dis-type">{disType(d.type, locale)}</span>
                  <span class={`tag dis-lvl lvl-${d.level}`}>{disLevel(d.level, locale)}</span>
                  {d.year && <span class="dis-year">{d.year}</span>}
                </div>
                {d.scope_zh && <p class="dis-scope">{tr(d.scope_zh, locale)}</p>}
                {/* 「也影响」跨职业链接暂不展示（数据保留在 d.also，后续 AI 工具栈功能用） */}
                {d.evidence_url && <a class="dis-src" href={d.evidence_url} target="_blank" rel="noopener nofollow">↗ {t.sources}</a>}
              </li>
            ))}
          </ul>
        </div>
      )}
      <div class="grid" style="grid-template-columns:1fr 1fr">
        {/* 2. 替代 3. 增强 */}
        <div class="card" data-section="ai-replaced"><strong class="amber">⚠ {t.aiReplaced}</strong>
          <ul>{o.ai.replaced_zh.map((x) => <li>{tr(x, locale)}</li>)}</ul></div>
        <div class="card" data-section="ai-augmented"><strong style="color:var(--green)">↑ {t.aiAugmented}</strong>
          <ul>{o.ai.augmented_zh.map((x) => <li>{tr(x, locale)}</li>)}</ul></div>
      </div>
      {/* 4. 人类护城河 | 5. 未来技能（并排对称） */}
      <div class="grid" style="grid-template-columns:1fr 1fr">
        <div class="card" data-section="ai-moat"><strong style="color:#2563eb">🛡 {t.aiMoat}</strong>
          <ul>{o.ai.moat_zh.map((x) => <li>{tr(x, locale)}</li>)}</ul></div>
        <div class="card" data-section="ai-skills"><strong>{t.aiSkills}</strong>
          <ul>{o.ai.skills_zh.map((x) => <li>{tr(x, locale)}</li>)}</ul></div>
      </div>
      {/* 6. 入门变窄 */}
      <div class="card" data-section="ai-entry"><strong>{t.aiEntry}</strong>
        <p class="muted" style="margin:6px 0 0;font-size:14px">{tr(o.ai.entry_narrowing_zh, locale)}</p></div>
      {/* 7. AI 时代升级路线 */}
      {o.ai.upgrade_path_zh && (
        <div class="card" data-section="ai-upgrade"><strong style="color:var(--green)">🚀 {t.aiUpgrade}</strong>
          <p style="margin:6px 0 0;font-size:14px">{tr(o.ai.upgrade_path_zh, locale)}</p></div>
      )}
      {/* 8. 你在 AI 图谱中的位置 */}
      {o.ai.cluster && (
        <div class="card" data-section="ai-position" style={`display:none;border-left:4px solid ${clusterColor(o.ai.cluster)}`}>
          <strong>🧭 {t.agMyPos.replace('{name}', i.name)}</strong>
          <p style="margin:6px 0 8px"><span class="tag" style={`color:${clusterColor(o.ai.cluster)};border-color:${clusterColor(o.ai.cluster)}`}>{clusterField(o.ai.cluster, 'name', locale)}</span></p>
          <div class="ai-scores">
            {[[t.agAuto, o.ai.automation_exposure], [t.agMoat, o.ai.human_moat], [t.agEntry, o.ai.entry_risk], [t.agUpside, o.ai.ai_upside]].map(([lbl, v]) => (
              <div class="scorerow"><span class="scorelbl">{lbl}</span>
                <span class="scorebar"><span class="scorefill" style={`width:${((Number(v) || 0) / 10) * 100}%`}></span></span>
                <span class="scoreval">{(Number(v) || 0).toFixed(1)}/10</span></div>
            ))}
          </div>
          <p style="margin:10px 0 0;font-size:13px"><a href={`/en/ai-graph/#${o.ai.cluster}`} style="color:var(--green);font-weight:600">{t.agViewGraph}</a></p>
        </div>
      )}
      {/* 9. 相邻职业 */}
      {o.ai.adjacent.length > 0 && (
        <div class="card" data-section="ai-adjacent"><strong>{t.aiAdjacent}</strong>
          <div class="chips" style="margin-top:8px">{o.ai.adjacent.map((j) => (
            <a class="tag mig" href={`/${country}/${locale}/${catSlug(j.category)}/${j.slug}/`}>{name(getBySlug(j.slug, country) || ({} as any), locale) || j.name_en}</a>
          ))}</div></div>
      )}
    </section>
  )}

  <PollBlock slug={slug} locale={locale} name={i.name} baked={o.polls} />

  <section data-section="salary">
  <h2>{t.salary}</h2>
  <table>
    <thead><tr><th>{t.experience}</th><th>{t.annual} ({cur})</th><th></th></tr></thead>
    <tbody>{o.salaries.map((s: any) => (
      <tr><td>{tr(s.label, locale)}</td><td class="amber">{money(s.min, country)} ~ {money(s.max, country)}</td><td class="muted">{tr(s.note, locale)}</td></tr>
    ))}</tbody>
  </table>
  </section>

  {o.education.length > 0 && (<section data-section="education">
    <h2>{t.education}</h2>
    <table><thead><tr><th>{t.stage}</th><th>{t.period}</th><th>{t.cost} ({cur})</th></tr></thead>
      <tbody>{o.education.map((e: any) => (
        <tr><td>{tr(e.stage, locale)}</td><td>{tr(e.duration, locale) || '—'}</td><td>{e.cost_min ? `${money(e.cost_min, country)}~${money(e.cost_max, country)}` : (tr(e.cost_note, locale) || '—')}</td></tr>
      ))}</tbody></table>
  </section>)}

  {o.qualifications.length > 0 && (<section data-section="qualifications">
    <h2>{t.qualifications}</h2>
    <table><thead><tr><th>{t.qualification}</th><th>{t.issuer}</th><th></th></tr></thead>
      <tbody>{o.qualifications.map((q: any) => (
        <tr><td>{tr(q.name, locale)}</td><td class="muted">{tr(q.issuer, locale) || '—'}</td><td>{q.mandatory ? <span class="tag mig">{t.mandatory}</span> : <span class="tag">{t.optional}</span>}</td></tr>
      ))}</tbody></table>
  </section>)}

  <section id="migration" data-section="visa">
  <h2>{t.visa}{t.visaToSuffix.replace('{c}', countryName(country, locale))}</h2>
  {o.is_migration ? (
    <>
    <p class="muted" style="font-size:13px;margin:0 0 8px">{t.visaCode}: <strong>{o.anzsco_code || o.occ_code}</strong>（{o.occ_code_type}）</p>
    {o.is_migration === 2 && <p class="card muted" style="font-size:13px;margin:0 0 10px">⚠ {migRestrictedNoteOf(country, locale)}</p>}
    <table><thead><tr><th>{t.visaCol}</th><th>{t.descCol}</th></tr></thead>
      <tbody>{o.visa.map((v: any) => (
        <tr><td><strong>{v.subclass}</strong> {tr(v.name, locale)}</td><td class="muted">{tr(v.desc, locale)}{v.min_score ? ` · ${t.inviteCutoff.replace('{n}', String(v.min_score)).replace('{asof}', v.score_asof || '')}` : ''}</td></tr>
      ))}</tbody></table>
    </>
  ) : (
    <p class="card muted">{t.nonMig}. {nonMigVisaOf(country, locale)}</p>
  )}
  {abroad.length > 0 && (
    <p class="muted" style="font-size:13px;margin:12px 0 0">{t.migrateOther}：
      {abroad.map((x: any) => (
        <a class="tag" style="margin:6px 6px 0 0;display:inline-block" href={`/${x.country}/${locale}/${catSlug(x.category)}/${x.slug}/#migration`}>
          <span set:html={COUNTRY_FLAG[x.country]} /> {countryName(x.country, locale)}</a>
      ))}
    </p>
  )}
  </section>

  <section data-section="suitability">
  <h2>{t.suitability}</h2>
  <div class="grid" style="grid-template-columns:1fr 1fr">
    <div class="card" data-section="suitability-fit"><strong class="amber" style="color:var(--green)">✓ {t.fit}</strong>
      <ul>{o.suitability.fit.map((x: string) => <li>{tr(x, locale)}</li>)}</ul></div>
    <div class="card" data-section="suitability-unfit"><strong class="amber">✗ {t.unfit}</strong>
      <ul>{o.suitability.unfit.map((x: string) => <li>{tr(x, locale)}</li>)}</ul></div>
  </div>
  </section>

  {(i.trend_summary || i.forecast_note || o.growth_areas.length > 0) && (<section data-section="growth">
    <h2>{t.growth}</h2>
    {i.trend_summary && <p>{i.trend_summary}</p>}
    {i.forecast_note && <p class="muted">{i.forecast_note}</p>}
    {o.growth_areas.length > 0 && (
      <p><span class="muted" style="font-size:13px">{t.growthKw}：</span><br />
        {o.growth_areas.map((g: string) => <span class="tag" style="margin:6px 6px 0 0;display:inline-block">{g}</span>)}</p>
    )}
  </section>)}

  {o.faqs.length > 0 && (<section data-section="faq">
    <h2>{t.faq}</h2>
    {o.faqs.map((f: any) => (<div style="margin-bottom:12px"><strong>{tr(f.question, locale)}</strong><div class="muted">{tr(f.answer, locale)}</div></div>))}
  </section>)}

  <section data-section="sources">
  <h2>{t.sources}</h2>
  <p class="card muted" style="font-size:13px">{sourcesBody(country, locale)}</p>
  </section>

  <style>
    .disruptors { list-style: none; margin: 10px 0 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
    .dis-item { padding: 10px 12px; border: 1px solid var(--border, #2a2a2a); border-radius: 8px; }
    .dis-head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
    .dis-name { font-weight: 700; color: var(--green); text-decoration: none; }
    .dis-name:hover { text-decoration: underline; }
    .dis-type { font-size: 12px; }
    .dis-lvl { font-size: 12px; }
    .dis-lvl.lvl-partial { color: #d97706; border-color: #d97706; }
    .dis-lvl.lvl-major { color: #ea580c; border-color: #ea580c; }
    .dis-lvl.lvl-full { color: #dc2626; border-color: #dc2626; }
    .dis-year { font-size: 12px; color: var(--muted, #9aa0a6); margin-left: auto; }
    .dis-scope { margin: 6px 0 0; font-size: 14px; line-height: 1.6; }
    .dis-also { margin: 8px 0 0; font-size: 13px; color: var(--muted, #9aa0a6); display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
    .dis-src { display: inline-block; margin: 8px 0 0; font-size: 12px; color: var(--muted, #9aa0a6); }
  </style>
</Base>
