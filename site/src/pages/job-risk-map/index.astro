---
// 全球 AI Job Risk Map（/job-risk-map/）：按 slug 跨国聚合的职业 treemap；
// 每格=一个职业（面积∝全球从业人数之和，颜色∝AI 替代风险），背后是世界地图水印。
// World/各国切换行由 RiskMap 组件统一提供。仅英文。
import Base from '../../layouts/Base.astro';
import RiskMap from '../../components/RiskMap.astro';
import { buildGlobalRiskMap, riskColor } from '../../lib/riskmap';

const layout = buildGlobalRiskMap();

// 客户端 tooltip / 高亮元数据：全球图方块链向 /jobs/{slug}（全球职业页）
const meta = layout.occs.map((o) => ({
  n: o.name, c: o.cat, w: o.workforce, r: Math.round(o.risk * 10) / 10,
  a: o.avgSalary, cur: o.currency, u: `/jobs/${o.slug}`,
  col: riskColor(o.risk),
}));

const title = 'AI Job Risk Map · World｜AI Career Graph';
const desc = 'Every occupation across all covered countries as a tile — area is the global workforce, colour is its AI automation risk, grouped by career category over a world map.';
---
<Base title={title} description={desc} locale="en" country="AU" global={true}>
  <section class="rm">
    <div class="rm-hero">
      <h1>AI Job Risk Map · World</h1>
      <p>Each tile is one occupation — <strong>area</strong> = global workforce, <strong>colour</strong> = AI
        automation exposure, aggregated across all covered countries. Hover for details; click to open.</p>
    </div>
    {!layout.hasData ? (
      <div class="card">No global layout available yet.</div>
    ) : (
      <RiskMap layout={layout} meta={meta} outlineKey="WORLD" activeKey="WORLD" ariaLabel="Global AI job risk map">
        <span slot="foot">
          Colour scale is the occupation’s AI automation-exposure score (1–10). Tile size is
          proportional to the combined workforce across all covered countries and is approximate.
          The faint silhouette behind the tiles is a low-resolution world map.
        </span>
      </RiskMap>
    )}
  </section>

  <style>
    /* 全宽左对齐：突破 Base 的 980px 窄栏，hero 与地图同宽同左边界（两侧不再留白） */
    .rm { margin-top: 6px; width: min(94vw, 1680px); margin-left: 50%; transform: translateX(-50%); }
    .rm-hero { margin: 0 0 8px; }
    .rm-hero h1 { font-size: 22px; margin: 0 0 4px; }
    .rm-hero p { font-size: 13px; color: var(--muted); margin: 0; }
  </style>
</Base>
