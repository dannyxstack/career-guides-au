---
// 一级聚合 URL：/{category}/{slug}（英文默认，裸 URL）—— 职业本体（全球 AI 数据 + 可用国家 Tab）。
// self-canonical；hreflang 覆盖 JOBS_LOCALES + x-default→英文。分类段取该 slug 代表副本的分类。
import Base from '../../layouts/Base.astro';
import JobDetail from '../../components/JobDetail.astro';
import { JOB_SLUGS, jobBySlug, jobAlternates, jobHref, strings, tr, name, countryTitleName, catSlug } from '../../lib/data';
import { DATA_UPDATED, SITE_NAME } from '../../lib/site-config';

export function getStaticPaths() {
  return JOB_SLUGS.map((slug) => ({ params: { category: catSlug(jobBySlug(slug)!.rep.category), slug } }));
}
const locale = 'en' as const;
const { slug } = Astro.params as { category: string; slug: string };
const group = jobBySlug(slug)!;
const rep = group.rep;
const t = strings(locale);
const dispName = name(rep, locale);

const title = `Will AI Replace ${dispName}? Risk, Tasks & Human Moat | ${t.siteTitle}`;
const gist = rep.ai ? tr(rep.ai.verdict_zh, locale) : '';
const description = (gist ? gist + ' ' : '')
  + `Available for ${group.countries.map((o) => countryTitleName(o.country, 'en')).join(', ')} — pick a country for local salary, licensing and migration.`;

const abs = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
const ld = [{
  '@context': 'https://schema.org', '@type': 'Occupation',
  name: dispName, description: gist || undefined,
  occupationalCategory: rep.anzsco_code || rep.occ_code || undefined,
  url: abs(jobHref(locale, slug)),
}, {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.siteTitle, item: abs('/') },
    { '@type': 'ListItem', position: 2, name: dispName, item: abs(jobHref(locale, slug)) },
  ],
}, {
  '@context': 'https://schema.org', '@type': 'WebPage', name: title, description,
  dateModified: DATA_UPDATED, publisher: { '@type': 'Organization', name: SITE_NAME },
  mainEntity: { '@type': 'Occupation', name: dispName },
}];
---
<Base title={title} description={description.slice(0, 155)} locale={locale} country={rep.country}
  global={true} alternates={jobAlternates(slug)} xDefault={jobHref('en', slug)} jsonLd={ld}>
  <JobDetail slug={slug} active={null} locale={locale} />
</Base>
