server {
    listen 80;
    listen [::]:80;
    server_name ismyjobaiproof.com www.ismyjobaiproof.com;

    root /var/www/ismyjobaiproof/current;
    index index.html;

    location /.well-known/acme-challenge/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
