---
import Base from '../../../layouts/Base.astro';
import { sectorById, occupationsInSector, sectorIcon } from '../../../lib/industries';
import { COUNTRIES, countryName, tr } from '../../../lib/data';
import { pageLocale, contentLocale, hrefJob, hrefIndustry, hrefIndustries, hrefMethodology, withL } from '../../../lib/i18n';
import { expBand, fmtSalary, fmtNum } from '../../../lib/ui';

const loc = pageLocale(Astro);
const CL = contentLocale(loc);
const { sector, country } = Astro.params;
const sec = sector ? sectorById(sector) : null;
if (!sec) return new Response('Not found', { status: 404 });

const cc = country && (COUNTRIES as readonly string[]).includes(country) ? country : 'US';
const rows = occupationsInSector(cc, sec.id, CL);
const secName = tr(sec.name, CL);
const countryOpts = COUNTRIES.map((c) => ({ c, href: hrefIndustry(loc, sec.id, c), name: countryName(c, CL) }));
---
<Base
  title={`${secName} — ${tr('AI exposure by occupation', CL)} | AI Job Risk`}
  description={`${tr('AI exposure, salary and workforce for occupations in this industry.', CL)} ${secName} · ${countryName(cc, CL)}`}
  active="industries"
>
  <div class="container">
    <nav class="breadcrumb"><a href={withL(loc, '/')}>{tr('Home', CL)}</a> <span>›</span> <a href={hrefIndustries(loc, cc)}>{tr('Industries', CL)}</a> <span>›</span> <span>{secName}</span></nav>

    <section class="hero">
      <div class="hero-text">
        <h1><i class={`fas ${sectorIcon(sec.id)}`}></i> {secName}</h1>
        <div class="hero-stats">
          <span><strong>{fmtNum(rows.length)}</strong> {tr('occupations', CL)}</span>
          <span><strong>{countryName(cc, CL)}</strong></span>
        </div>
      </div>
      <label class="country-select">
        <i class="fas fa-globe"></i>
        <select onchange="if(this.value)window.location.href=this.value;">
          {countryOpts.map((o) => <option value={o.href} selected={o.c === cc}>{o.name}</option>)}
        </select>
      </label>
    </section>

    <dl class="col-legend">
      <div><dt>{tr('AI exposure', CL)}</dt><dd>{tr('Generative-AI task-exposure percentile (0–100); higher = more exposed.', CL)} <a href={hrefMethodology(loc)}>{tr('Methodology', CL)} →</a></dd></div>
      <div><dt>{tr('Industry share', CL)}</dt><dd>{tr("Share of this occupation's employment that sits within this industry (many-to-many mapping).", CL)}</dd></div>
      <div><dt>{tr('Avg salary', CL)}</dt><dd>{tr('Average annual salary (local currency), from official labour statistics.', CL)} · {countryName(cc, CL)}</dd></div>
      <div><dt>{tr('Workforce', CL)}</dt><dd>{tr('Estimated number of people employed in the occupation nationally.', CL)}</dd></div>
    </dl>

    <section class="table-section card">
      <div class="table-wrapper">
        <table id="occ-table">
          <thead>
            <tr>
              <th data-key="name" class="active-sort">{tr('Occupation', CL)} <span class="aff">▼</span></th>
              <th data-key="aioe" class="num">{tr('AI exposure', CL)} <span class="aff">▲</span></th>
              <th data-key="share" class="num">{tr('Industry share', CL)} <span class="aff">▲</span></th>
              <th data-key="salary" class="num">{tr('Avg salary', CL)} <span class="aff">▲</span></th>
              <th data-key="workforce" class="num">{tr('Workforce', CL)} <span class="aff">▲</span></th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => {
              const b = expBand(r.aioe);
              return (
                <tr data-name={r.name} data-aioe={r.aioe ?? -1} data-share={r.pct} data-salary={r.salary ?? -1} data-workforce={r.workforce ?? -1}>
                  <td class="occ-name"><a href={hrefJob(loc, r.slug, cc)}>{r.name}</a></td>
                  <td class="num"><div class="risk-cell">{r.aioe ?? '—'} {r.aioe != null && <span class={`risk-badge ${b.cls}`}>{tr(b.label, CL)}</span>}</div></td>
                  <td class="num">{r.pct.toFixed(1)}%</td>
                  <td class="num">{fmtSalary(r.salary, cc)}</td>
                  <td class="num">{fmtNum(r.workforce)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <div class="footnote card">
      <strong>{tr('About the data:', CL)}</strong> {tr("Occupation–industry mapping from the BLS National Employment Matrix. AI-exposure scores based on ILO Working Paper 140 and Eloundou et al. (OpenAI). An occupation may appear in several industries — exposure reflects the occupation overall, not industry-specific. Industry share = the occupation's employment share within this industry.", CL)}
    </div>
  </div>

  <script is:inline>
    (function () {
      var table = document.getElementById('occ-table');
      if (!table) return;
      var tbody = table.querySelector('tbody');
      var ths = table.querySelectorAll('th');
      var state = { key: 'workforce', dir: -1 };
      function sort(key) {
        var dir = state.key === key ? -state.dir : (key === 'name' ? 1 : -1);
        state = { key: key, dir: dir };
        var rows = Array.prototype.slice.call(tbody.querySelectorAll('tr'));
        rows.sort(function (a, b) {
          var av = a.getAttribute('data-' + key), bv = b.getAttribute('data-' + key);
          if (key === 'name') return dir * av.localeCompare(bv);
          return dir * (parseFloat(av) - parseFloat(bv));
        });
        rows.forEach(function (r) { tbody.appendChild(r); });
        ths.forEach(function (th) {
          th.classList.toggle('active-sort', th.getAttribute('data-key') === key);
          var aff = th.querySelector('.aff');
          if (aff) aff.textContent = th.getAttribute('data-key') === key ? (dir < 0 ? '▼' : '▲') : '▲';
        });
      }
      ths.forEach(function (th) { th.addEventListener('click', function () { sort(th.getAttribute('data-key')); }); });
    })();
  </script>

  <style>
    .breadcrumb { display: flex; gap: 6px; align-items: center; padding: 18px 0 8px; font-size: 0.85rem; color: var(--text-muted); }
    .breadcrumb a { color: var(--text-muted); } .breadcrumb a:hover { color: var(--brand); }
    .hero { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 16px; padding: 6px 0 22px; }
    .hero-text h1 { font-size: 1.9rem; margin: 0; }
    .hero-text h1 i { color: var(--brand); margin-right: 8px; }
    .hero-stats { display: flex; gap: 20px; margin-top: 10px; color: var(--text-body); font-size: 0.95rem; }
    .hero-stats strong { color: var(--text-strong); }
    .country-select { display: inline-flex; align-items: center; gap: 8px; background: var(--surface);
      border: 1px solid var(--line); border-radius: 12px; padding: 8px 14px; box-shadow: var(--shadow); }
    .country-select i { color: var(--text-muted); }
    .country-select select { border: none; background: transparent; font: inherit; color: var(--text-strong); font-weight: 500; cursor: pointer; outline: none; }
    /* overflow:hidden / overflow-x:auto 会困住 sticky（形成滚动容器），故桌面端不设，
       仅窄屏才开横向滚动；表头 sticky 到 nav（64px）下方，z-index 低于 nav 不冲突。 */
    /* 列说明图例：紧凑小字、两列自适应，不占太多屏幕 */
    .col-legend { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 4px 22px;
      margin: 4px 0 14px; padding: 12px 16px; background: var(--surface-tint-2); border: 1px solid var(--line);
      border-radius: 12px; font-size: 0.78rem; line-height: 1.5; }
    .col-legend div { display: flex; gap: 6px; }
    .col-legend dt { flex: none; font-weight: 700; color: var(--text-strong); white-space: nowrap; }
    .col-legend dt::after { content: "—"; margin-left: 4px; color: var(--text-muted); font-weight: 400; }
    .col-legend dd { margin: 0; color: var(--text-muted); }
    .col-legend a { color: var(--brand); white-space: nowrap; }
    .col-legend a:hover { text-decoration: underline; }
    .table-section { padding: 0; margin-bottom: 22px; }
    table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
    th { position: sticky; top: 64px; z-index: 5;
      background: var(--surface-tint-2); color: var(--text-strong); font-weight: 600; text-align: left;
      padding: 13px 12px; border-bottom: 2px solid var(--line); font-size: 0.74rem; text-transform: uppercase;
      letter-spacing: .03em; cursor: pointer; white-space: nowrap; user-select: none; }
    th.num { text-align: right; }
    th.active-sort { color: var(--brand); }
    th .aff { color: var(--text-muted); font-size: 0.7rem; margin-left: 4px; }
    th.active-sort .aff { color: var(--brand); }
    td { padding: 11px 12px; border-bottom: 1px solid var(--line); }
    td.num { text-align: right; font-variant-numeric: tabular-nums; color: var(--text-body); }
    tr:last-child td { border-bottom: none; }
    .occ-name a { color: var(--text-strong); font-weight: 500; }
    .occ-name a:hover { color: var(--brand); }
    .risk-cell { display: inline-flex; align-items: center; gap: 8px; justify-content: flex-end; }
    .footnote { font-size: 0.85rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 20px; }
    .footnote strong { color: var(--text-strong); }
    /* 窄屏：开横向滚动（此时 sticky 让位给可滚动，表头不再置顶，可接受） */
    @media (max-width: 680px) {
      .table-wrapper { overflow-x: auto; }
      table { min-width: 620px; }
      th { position: static; }
    }
  </style>
</Base>
