---
import Base from '../layouts/Base.astro';
import { JOB_SLUGS, jobBySlug, COUNTRIES, name as occName } from '../lib/data';
import { buildBoards } from '../lib/rankings';
import { categoryIcon } from '../lib/industries';
import { pageLocale, contentLocale, hrefJob, hrefIndustries, hrefRankings, hrefCompare, hrefSearch } from '../lib/i18n';
import { expBand } from '../lib/ui';

const loc = pageLocale(Astro);
const CL = contentLocale(loc);

// —— 统计 ——
const globalJobs = JOB_SLUGS.length;
const countryCount = COUNTRIES.length;
// 全球职业（按 slug 去重），带聚合暴露/人数
const globals = JOB_SLUGS.map((s) => jobBySlug(s)!).filter(Boolean);
const withExp = globals.filter((g) => g.rep.ai?.aioe_pct != null);
const highExp = withExp.filter((g) => (g.rep.ai!.aioe_pct as number) >= 70).length;
const pctHigh = withExp.length ? Math.round((highExp / withExp.length) * 100) : 0;

// —— 热门职业：全球从业人数最高、且有暴露分的可识别职业 ——
const hotJobs = globals
  .map((g) => ({
    slug: g.slug, cat: g.rep.category,
    name: occName(g.rep, CL),
    exp: g.rep.ai?.aioe_pct ?? null,
    work: g.countries.reduce((s, o) => s + (o.workforce_size || 0), 0),
  }))
  .filter((j) => j.exp != null && j.work > 0)
  .sort((a, b) => b.work - a.work)
  .slice(0, 12);

// —— 榜单预览（US）——
const boards = buildBoards('US', 5);
const mostExposed = boards.find((b) => b.id === 'most-exposed')!;
const leastExposed = boards.find((b) => b.id === 'least-exposed')!;

function barColor(pct: number) {
  if (pct >= 70) return 'linear-gradient(90deg,#f59e0b,#dc2626)';
  if (pct >= 40) return '#f59e0b';
  return '#059669';
}
function pctColor(pct: number) {
  return pct >= 70 ? '#dc2626' : pct >= 40 ? '#f59e0b' : '#059669';
}

const FAQ = [
  { q: 'Which jobs will AI most likely replace?', a: 'The highest-exposure roles are repetitive and rule-based — clerks, data entry, standard writing and lookup tasks. Their work is highly structured and easy to model. Even so, full replacement is rare; more often the task mix is reshaped.' },
  { q: 'What exactly is the "human moat"?', a: 'The human moat is the set of capabilities AI struggles to replace: complex judgement, empathy and care relationships, creativity, cross-domain integration, and face-to-face trust. These rely on human experience, intuition and accountability.' },
  { q: 'My job scores high risk — should I switch careers now?', a: 'Not blindly. High risk does not mean unemployment; it means your task mix is being reshaped. Learn to use AI tools, move toward AI-augmented work, and strengthen moat skills like client communication and strategic judgement. Assess before you act.' },
  { q: 'How is the AI exposure score calculated?', a: 'The exposure percentile comes from two open, authoritative studies — the ILO\'s Working Paper 140 and Eloundou et al. "GPTs are GPTs" (OpenAI) — mapped onto official occupation classifications, not our own opinion.' },
  { q: 'Is the ranking data reliable?', a: 'We integrate public labour statistics (BLS, ONS, ABS, etc.), official occupation classifications, and published AI-capability research. All figures are estimates, sourced and updated periodically, and indicative only.' },
];
const faqLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base
  title="AI Job Risk — is your job still here in 5 years?"
  description={`Check AI replacement risk, task exposure and the human moat across ${globalJobs.toLocaleString('en')} occupations in ${countryCount} countries, with local salary, licensing and outlook.`}
  active="occupations"
  jsonLd={faqLd}
>
  <div class="container">
    <!-- HERO -->
    <section class="hero">
      <h1>Is your job still here in <span class="hl">5 years</span>?</h1>
      <p class="sub">{globalJobs.toLocaleString('en')}+ occupations · {countryCount} countries · task-level AI exposure analysis</p>
      <div class="stat-badge"><i class="fas fa-robot"></i> {pctHigh}% of occupations already have high AI exposure</div>

      <form class="search-box" action={hrefSearch(loc)} method="get" role="search">
        <input type="text" name="q" placeholder="Search a job, e.g. “Software Engineer”…" aria-label="Search occupations" />
        <button type="submit"><i class="fas fa-search"></i> Analyse</button>
      </form>

      <div class="hot-tags">
        {hotJobs.slice(0, 6).map((j) => (
          <a class="tag" href={hrefJob(loc, j.slug)}><i class="fas fa-fire"></i> {j.name}</a>
        ))}
      </div>

      <div class="stats-grid">
        <div class="item"><div class="number">{globalJobs.toLocaleString('en')}</div><div class="label">Occupations</div></div>
        <div class="item"><div class="number">{countryCount}</div><div class="label">Countries</div></div>
        <div class="item"><div class="number">{pctHigh}%</div><div class="label">High AI exposure</div></div>
        <div class="item"><div class="number">20</div><div class="label">Industry sectors</div></div>
      </div>
    </section>

    <!-- RANKINGS PREVIEW -->
    <div class="section-header">
      <h2>AI replacement-risk rankings</h2>
      <div class="sub">Evidence-based, sortable — see where an occupation lands (United States)</div>
    </div>
    <div class="rank-preview">
      <div class="rank-box">
        <h3><i class="fas fa-triangle-exclamation" style="color:var(--risk-high)"></i> Most exposed to AI</h3>
        <ul class="rank-list">
          {mostExposed.items.map((it) => (
            <li>
              <a href={hrefJob(loc, it.slug)}>{it.name}</a>
              <span class="risk-high">{it.aioe}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="rank-box">
        <h3><i class="fas fa-shield-halved" style="color:var(--risk-low)"></i> Least exposed · deep moat</h3>
        <ul class="rank-list">
          {leastExposed.items.map((it) => (
            <li>
              <a href={hrefJob(loc, it.slug)}>{it.name}</a>
              <span class="risk-low">{it.aioe}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- EXPLORE -->
    <div class="section-header">
      <h2>Explore more</h2>
      <div class="sub">Dig into the data from more angles</div>
    </div>
    <div class="explore-grid">
      <a href={hrefCompare(loc)} class="explore-card">
        <i class="fas fa-arrow-right-arrow-left"></i>
        <h4>Compare careers</h4>
        <p>AI risk, salary and moat, side by side</p>
      </a>
      <a href={hrefIndustries(loc)} class="explore-card">
        <i class="fas fa-industry"></i>
        <h4>Browse by industry</h4>
        <p>See exposure across 20 industry sectors</p>
      </a>
      <a href={hrefRankings(loc)} class="explore-card">
        <i class="fas fa-ranking-star"></i>
        <h4>All rankings</h4>
        <p>Exposure, pay, demand and workforce</p>
      </a>
    </div>

    <!-- HOT JOBS -->
    <div class="section-header">
      <h2>Popular occupations</h2>
      <div class="sub">The jobs people check most — and their AI exposure</div>
    </div>
    <div class="hot-jobs-grid">
      {hotJobs.map((j) => {
        const pct = j.exp as number;
        return (
          <a class="hot-job-card" href={hrefJob(loc, j.slug)}>
            <div class="job-name">{j.name}</div>
            <div class="job-industry"><i class={`fas ${categoryIcon(j.cat)}`}></i> {j.cat}</div>
            <div class="risk-row">
              <span class="rl">exposure</span>
              <div class="risk-track"><div class="fill" style={`width:${pct}%;background:${barColor(pct)}`}></div></div>
              <span class="risk-pct" style={`color:${pctColor(pct)}`}>{pct}</span>
            </div>
          </a>
        );
      })}
    </div>

    <!-- FAQ -->
    <div class="faq-block">
      <h2>Common questions about AI job risk</h2>
      {FAQ.map((f) => (
        <details class="faq-item">
          <summary>{f.q}<i class="fas fa-chevron-down"></i></summary>
          <div class="faq-answer">{f.a}</div>
        </details>
      ))}
    </div>

    <!-- SOURCES -->
    <div class="source-block">
      <strong><i class="fas fa-database"></i> About the data</strong>
      <p>Occupation and employment data integrate official labour statistics — U.S. Bureau of Labor Statistics (BLS), UK ONS, Australia ABS, Statistics Canada, Germany destatis and others. AI-exposure scores derive from <strong>ILO Working Paper 140</strong> and <strong>Eloundou et al. (OpenAI)</strong>. Occupation-to-industry mapping uses the BLS National Employment Matrix (many-to-many). Figures are estimates, updated periodically, and indicative only.</p>
    </div>
  </div>

  <style>
    .hero { padding: 52px 24px 40px; text-align: center; margin-top: 20px; border-radius: 28px;
      background: linear-gradient(145deg, var(--surface) 0%, var(--surface-tint-2) 100%); border: 1px solid var(--line); }
    .hero h1 { font-size: clamp(2rem, 5vw, 3.2rem); font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; margin: 0; }
    .hero h1 .hl { background: linear-gradient(135deg, var(--brand), #7c3aed); color: #fff; padding: 0 16px; border-radius: 60px; display: inline-block; }
    .hero .sub { font-size: 1.15rem; color: var(--text-body); margin: 18px 0 12px; }
    .stat-badge { background: var(--brand-tint); color: var(--brand); padding: 8px 26px; border-radius: 60px; display: inline-block; font-weight: 600; margin-bottom: 26px; }
    .stat-badge i { margin-right: 8px; }
    .search-box { max-width: 680px; margin: 0 auto; display: flex; background: var(--surface); border-radius: 80px;
      box-shadow: 0 12px 30px rgba(37,99,235,.12); border: 1px solid var(--line); overflow: hidden; }
    .search-box input { flex: 1; border: none; padding: 17px 26px; font-size: 1.05rem; background: transparent; outline: none; color: var(--text); }
    .search-box button { background: var(--brand); border: none; color: #fff; padding: 0 34px; font-weight: 600; font-size: 1.02rem; cursor: pointer; white-space: nowrap; }
    .search-box button:hover { background: var(--brand-hover); }
    .hot-tags { margin-top: 26px; display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
    .hot-tags .tag { background: var(--surface); padding: 8px 18px; border-radius: 40px; font-size: 0.85rem; font-weight: 500;
      color: var(--text-strong); border: 1px solid var(--line); }
    .hot-tags .tag i { margin-right: 6px; color: var(--brand); }
    .hot-tags .tag:hover { border-color: var(--brand); background: var(--surface-tint-2); }
    .stats-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 32px 72px; margin: 38px auto 0; padding: 22px 0 4px;
      border-top: 1px solid var(--line); max-width: 820px; }
    .stats-grid .number { font-size: 2rem; font-weight: 700; color: var(--text); }
    .stats-grid .label { color: var(--text-muted); font-size: 0.92rem; }

    .section-header { margin: 48px 0 18px; text-align: center; }
    .section-header h2 { font-size: 1.75rem; font-weight: 700; }
    .section-header .sub { color: var(--text-muted); margin-top: 4px; }

    .rank-preview { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    .rank-box { background: var(--surface); border: 1px solid var(--line); border-radius: 20px; padding: 22px 24px; box-shadow: var(--shadow); }
    .rank-box h3 { font-size: 1.15rem; margin: 0 0 14px; display: flex; align-items: center; gap: 10px; }
    .rank-list { list-style: none; margin: 0; padding: 0; }
    .rank-list li { display: flex; justify-content: space-between; gap: 12px; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--line); }
    .rank-list li:last-child { border-bottom: none; }
    .rank-list a { color: var(--text-strong); font-weight: 500; }
    .rank-list a:hover { color: var(--brand); }
    .risk-high { color: var(--risk-high); font-weight: 700; } .risk-low { color: var(--risk-low); font-weight: 700; }

    .explore-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .explore-card { background: var(--surface); border: 1px solid var(--line); border-radius: 18px; padding: 26px; text-align: center;
      box-shadow: var(--shadow); color: var(--text); transition: .15s; }
    .explore-card:hover { border-color: var(--brand); transform: translateY(-3px); }
    .explore-card i { font-size: 1.9rem; color: var(--brand); margin-bottom: 10px; }
    .explore-card h4 { font-size: 1.12rem; margin: 0 0 4px; }
    .explore-card p { color: var(--text-muted); font-size: 0.88rem; margin: 0; }

    .hot-jobs-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
    .hot-job-card { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 18px 20px;
      box-shadow: var(--shadow); color: var(--text); transition: .12s; display: block; }
    .hot-job-card:hover { border-color: var(--brand); transform: translateY(-2px); }
    .hot-job-card .job-name { font-weight: 600; font-size: 1.02rem; color: var(--text); }
    .hot-job-card .job-industry { font-size: 0.78rem; color: var(--text-muted); margin-top: 3px; }
    .risk-row { display: flex; align-items: center; gap: 10px; margin-top: 12px; }
    .risk-row .rl { font-size: 0.75rem; color: var(--text-muted); }
    .risk-track { flex: 1; height: 6px; background: var(--surface-tint); border-radius: 40px; overflow: hidden; }
    .risk-track .fill { height: 100%; border-radius: 40px; }
    .risk-pct { font-weight: 700; font-size: 0.85rem; min-width: 26px; text-align: right; }

    .faq-block { background: var(--surface); border: 1px solid var(--line); border-radius: 20px; padding: 26px 32px; margin-top: 40px; box-shadow: var(--shadow); }
    .faq-block h2 { font-size: 1.5rem; margin: 0 0 14px; }
    .faq-item { border-bottom: 1px solid var(--line); }
    .faq-item:last-child { border-bottom: none; }
    .faq-item summary { list-style: none; cursor: pointer; padding: 16px 0; font-weight: 600; color: var(--text);
      display: flex; justify-content: space-between; align-items: center; }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item summary i { color: var(--text-muted); font-size: 0.8rem; transition: transform .2s; }
    .faq-item[open] summary i { transform: rotate(180deg); }
    .faq-item summary:hover { color: var(--brand); }
    .faq-answer { padding: 0 0 18px; color: var(--text-body); font-size: 0.94rem; line-height: 1.7; }

    .source-block { background: var(--bg-soft); border: 1px solid var(--line); border-radius: 16px; padding: 20px 26px;
      margin-top: 24px; font-size: 0.86rem; color: var(--text-muted); line-height: 1.7; }
    .source-block strong { color: var(--text-strong); }
    .source-block p { margin: 6px 0 0; }

    @media (max-width: 900px) {
      .hot-jobs-grid { grid-template-columns: repeat(2, 1fr); }
      .explore-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 640px) {
      .rank-preview { grid-template-columns: 1fr; }
      .hot-jobs-grid { grid-template-columns: 1fr; }
      .hero { padding: 36px 16px 30px; }
    }
  </style>
</Base>
