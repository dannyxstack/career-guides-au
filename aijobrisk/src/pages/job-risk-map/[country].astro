---
import Base from '../../layouts/Base.astro';
import RiskMap from '../../components/RiskMap.astro';
import { buildRiskMap } from '../../lib/riskmap';
import { riskMeta } from '../../lib/riskmap-meta';
import { COUNTRIES, countryName } from '../../lib/data';
import { pageLocale, contentLocale } from '../../lib/i18n';

const loc = pageLocale(Astro);
const CL = contentLocale(loc);
const { country } = Astro.params;
const cc = country && (COUNTRIES as readonly string[]).includes(country) ? country : null;
if (!cc) return new Response('Not found', { status: 404 });

const layout = buildRiskMap(cc);
const meta = riskMeta(layout, loc);
const cn = countryName(cc, CL);
---
<Base
  title={`AI Job Risk Map — ${cn} | AI Job Risk`}
  description={`A treemap of the ${cn} workforce coloured by AI automation exposure — area is workforce, colour is AI risk.`}
  active="map"
>
  <div class="container map-wrap">
    <header class="map-head">
      <h1>AI Job Risk Map — {cn}</h1>
      <p class="subhead">Each tile is an occupation; area is its {cn} workforce and colour is AI automation exposure (green = lower, red = higher). Hover for details, click to open the occupation.</p>
    </header>
    {layout.hasData ? (
      <RiskMap layout={layout} meta={meta} outlineKey={cc} activeKey={cc} locale={loc} ariaLabel={`${cn} AI job risk treemap`}>
        <span slot="foot">Area ∝ workforce. Colour ∝ AI automation exposure (1–10). Estimates only.</span>
      </RiskMap>
    ) : (
      <p class="card muted">No workforce / exposure data available to render a map for {cn}.</p>
    )}
  </div>
  <style>
    .map-wrap { padding-top: 20px; }
    .map-head { margin-bottom: 16px; }
    .map-head h1 { font-size: 2rem; margin: 0 0 8px; }
    .subhead { color: var(--text-muted); max-width: 760px; margin: 0; }
  </style>
</Base>
