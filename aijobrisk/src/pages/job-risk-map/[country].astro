---
import Base from '../../layouts/Base.astro';
import RiskMap from '../../components/RiskMap.astro';
import { buildRiskMap } from '../../lib/riskmap';
import { riskMeta } from '../../lib/riskmap-meta';
import { COUNTRIES, countryName, tr } from '../../lib/data';
import { pageLocale, contentLocale } from '../../lib/i18n';

const loc = pageLocale(Astro);
const CL = contentLocale(loc);
const { country } = Astro.params;
const cc = country && (COUNTRIES as readonly string[]).includes(country) ? country : null;
if (!cc) return new Response('Not found', { status: 404 });

const layout = buildRiskMap(cc);
const meta = riskMeta(layout, loc);
const cn = countryName(cc, CL);
---
<Base
  title={`${tr('AI Job Risk Map', CL)} — ${cn} | AI Job Risk`}
  description={`${tr('A treemap of the workforce coloured by AI automation exposure — area is workforce, colour is AI risk.', CL)} · ${cn}`}
  active="map"
>
  <div class="container map-wrap">
    <header class="map-head">
      <h1>{tr('AI Job Risk Map', CL)} — {cn}</h1>
      <p class="subhead">{tr('Each tile is an occupation; area is its workforce and colour is AI automation exposure (green = lower, red = higher). Hover for details, click to open the occupation.', CL)}</p>
    </header>
    {layout.hasData ? (
      <RiskMap layout={layout} meta={meta} outlineKey={cc} activeKey={cc} locale={loc} ariaLabel={`${cn} ${tr('AI job risk treemap', CL)}`}>
        <span slot="foot">{tr('Area ∝ workforce. Colour ∝ AI automation exposure (1–10). Estimates only.', CL)}</span>
      </RiskMap>
    ) : (
      <p class="card muted">{tr('No workforce / exposure data available to render a map.', CL)} · {cn}</p>
    )}
  </div>
  <style>
    .map-wrap { padding-top: 20px; }
    .map-head { margin-bottom: 16px; }
    .map-head h1 { font-size: 2rem; margin: 0 0 8px; }
    .subhead { color: var(--text-muted); max-width: 760px; margin: 0; }
  </style>
</Base>
