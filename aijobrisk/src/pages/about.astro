---
import Base from '../layouts/Base.astro';
import { strings } from '../lib/data';
import { pageLocale, contentLocale, withL } from '../lib/i18n';
const loc = pageLocale(Astro);
const t = strings(contentLocale(loc));
const sections = [
  { h: t.abS1h, b: [t.abS1] },
  { h: t.abS2h, b: [t.abS2a, t.abS2b] },
  { h: t.abS3h, b: [t.abS3a, t.abS3b] },
  { h: t.abS4h, b: [t.abS4a, t.abS4b] },
  { h: t.abS5h, b: [t.abS5] },
  { h: t.abS6h, b: [t.abS6] },
];
---
<Base title="About — AI Job Risk" description={t.abLead} active="about">
  <div class="container prose">
    <h1>{t.abTitle}</h1>
    <p class="lead">{t.abLead}</p>
    {sections.map((s) => (
      <section><h2>{s.h}</h2>{s.b.map((p) => <p>{p}</p>)}</section>
    ))}
    <p class="muted note">Related: <a href={withL(loc, '/methodology')}>how the AI Exposure Index is computed</a> · <a href={withL(loc, '/rankings')}>rankings</a> · <a href={withL(loc, '/industries')}>industries</a>.</p>
  </div>
  <style>
    .prose { max-width: 820px; padding: 36px 0 24px; }
    .prose h1 { font-size: 2.1rem; margin: 0 0 12px; }
    .prose .lead { font-size: 1.12rem; color: var(--text-body); margin: 0 0 8px; }
    .prose h2 { font-size: 1.25rem; margin: 28px 0 8px; }
    .prose p { color: var(--text-body); margin: 0 0 10px; line-height: 1.7; }
    .note { font-size: 0.85rem; margin-top: 24px; }
  </style>
</Base>
