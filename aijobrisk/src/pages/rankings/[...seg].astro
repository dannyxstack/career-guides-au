---
// 榜单：单一 catch-all，国家走路径末级（取代旧 ?country=）。见 RULES.md 路由规约。
// 支持：/rankings（hub·默认 US）、/rankings/{country}（hub·某国）、
//       /rankings/{board}（榜单详情·默认 US）、/rankings/{board}/{country}（榜单详情·某国）。
// board id 与国家码不重叠，故单一 catch-all 自行解析、无冲突。
import Base from '../../layouts/Base.astro';
import { buildBoards, boardById, type Board, type RankItem } from '../../lib/rankings';
import { COUNTRIES, countryName, occByCountry, JOB_SLUGS, tr } from '../../lib/data';
import { categoryIcon } from '../../lib/industries';
import { pageLocale, contentLocale, hrefJob, hrefRankings, hrefBoard, withL } from '../../lib/i18n';
import { expBand, fmtSalary, fmtNum } from '../../lib/ui';
import { DATA_UPDATED } from '../../lib/site-config';

const loc = pageLocale(Astro);
const CL = contentLocale(loc);

const BOARD_IDS = ['most-exposed', 'least-exposed', 'highest-paying', 'largest-workforce', 'strongest-demand', 'deepest-moat'];
const COUNTRY_SET = new Set(COUNTRIES as readonly string[]);

// —— 解析 rest 参数 ——
const segs = (Astro.params.seg || '').split('/').filter(Boolean);
let board: string | null = null;
let cc = 'US';
if (segs.length === 0) {
  // /rankings → hub·默认 US
} else if (BOARD_IDS.includes(segs[0])) {
  board = segs[0];
  if (segs[1]) {
    if (COUNTRY_SET.has(segs[1])) cc = segs[1];
    else return new Response('Not found', { status: 404 });
  }
} else if (segs.length === 1 && COUNTRY_SET.has(segs[0])) {
  cc = segs[0];
} else {
  return new Response('Not found', { status: 404 });
}
const isBoard = board != null;

// 国家切换：跳到同视图的该国 URL（保持 hub / 某 board）
const countryUrl = (c: string) => isBoard ? hrefBoard(loc, board!, c) : hrefRankings(loc, c);

const BOARD_ICON: Record<string, string> = {
  'most-exposed': 'fa-circle-exclamation', 'least-exposed': 'fa-shield-halved', 'highest-paying': 'fa-star',
  'largest-workforce': 'fa-users', 'strongest-demand': 'fa-arrow-trend-up', 'deepest-moat': 'fa-chess-rook',
};

// ============ HUB 模式数据 ============
const boardsHub = !isBoard ? buildBoards(cc, 5, CL) : [];
const BOARD_TONE: Record<string, string> = {
  'most-exposed': 'high', 'least-exposed': 'low', 'highest-paying': 'gold',
  'largest-workforce': 'slate', 'strongest-demand': 'brand', 'deepest-moat': 'moat',
};
function primary(b: Board, it: RankItem): string {
  if (b.metric === 'salary') return fmtSalary(it.salary, cc);
  if (b.metric === 'workforce') return fmtNum(it.workforce);
  if (b.metric === 'demand') return `${it.demand}/10`;
  if (b.metric === 'moat') return `${it.moat}/10`;
  return String(it.aioe);
}
function secondary(b: Board, it: RankItem): string {
  if (b.metric === 'aioe') return fmtSalary(it.salary, cc);
  return it.aioe != null ? `${tr('exposure', CL)} ${it.aioe}` : '';
}

// ============ BOARD 模式数据 ============
const b = isBoard ? boardById(cc, board!, 50, CL) : null;
if (isBoard && !b) return new Response('Not found', { status: 404 });

const metricCol = b && (b.metric === 'workforce'
  ? { label: tr('Workforce', CL), fn: (it: RankItem) => fmtNum(it.workforce) }
  : b.metric === 'demand'
  ? { label: tr('Demand', CL), fn: (it: RankItem) => (it.demand != null ? `${it.demand}/10` : '—') }
  : { label: tr('Avg salary', CL), fn: (it: RankItem) => fmtSalary(it.salary, cc) });

function tag(aioe: number | null) {
  const bd = expBand(aioe);
  if (bd.cls === 'critical' || bd.cls === 'high') return { cls: 'high', label: tr(bd.label, CL) };
  if (bd.cls === 'moderate') return { cls: 'mid', label: tr('moderate', CL) };
  return { cls: 'low', label: tr(bd.label, CL) };
}
function barColor(aioe: number | null) {
  if (aioe == null) return '#cbd5e1';
  if (aioe >= 70) return 'linear-gradient(90deg,#f59e0b,#dc2626)';
  if (aioe >= 40) return '#f59e0b';
  return '#059669';
}
function pctColor(aioe: number | null) {
  if (aioe == null) return 'var(--text-muted)';
  return aioe >= 70 ? 'var(--risk-high)' : aioe >= 40 ? 'var(--risk-mid-fg)' : 'var(--risk-low)';
}
function moat(v: number | null) {
  if (v == null) return { cls: 'moderate', label: tr('n/a', CL) };
  if (v >= 7) return { cls: 'strong', label: tr('Strong', CL) };
  if (v >= 4) return { cls: 'moderate', label: tr('Moderate', CL) };
  return { cls: 'weak', label: tr('Weak', CL) };
}

// 头部分布统计（board 模式）
const dist = { high: 0, mid: 0, low: 0, total: 0 };
if (isBoard) {
  for (const o of occByCountry(cc)) {
    const p = o.ai?.aioe_pct;
    if (p == null) continue;
    dist.total++;
    if (p >= 70) dist.high++; else if (p >= 40) dist.mid++; else dist.low++;
  }
}
const pct = (n: number) => (dist.total ? Math.round((n / dist.total) * 100) : 0);

const FAQ = [
  { q: tr('How is the AI exposure percentile calculated?', CL), a: tr('It comes from two open studies — the ILO Working Paper 140 and Eloundou et al. "GPTs are GPTs" (OpenAI) — mapped onto official occupation classifications. It is a percentile (0–100): higher means more exposed to generative AI.', CL) },
  { q: tr('Does high exposure mean the job disappears?', CL), a: tr('No. High exposure means a larger share of the tasks can be done or assisted by AI — the task mix is reshaped, entry-level roles may shrink, and AI-fluent workers gain leverage. It is not a prediction of unemployment.', CL) },
  { q: tr('What is the human moat?', CL), a: tr('The capabilities AI struggles to replace: complex judgement, on-site work, licensed accountability, empathy and care, and face-to-face trust. A deeper moat makes an occupation more resilient.', CL) },
  { q: tr('How is this ranking produced?', CL), a: tr('Rankings are computed automatically by transparent rules from official labour statistics and the exposure scores — not hand-picked. Figures are estimates, updated periodically, and indicative only.', CL) },
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

// —— 页面 meta ——
const title = isBoard
  ? `${b!.title} — ${tr('full ranking', CL)} (${countryName(cc, CL)}) | AI Job Risk`
  : `${tr('Job risk & opportunity rankings', CL)} | AI Job Risk`;
const description = isBoard
  ? `${b!.title}: ${b!.desc} · ${countryName(cc, CL)}`
  : `${tr('How exposed is your job to generative AI? Compare salary, workforce, demand and human resilience across occupations.', CL)} · ${countryName(cc, CL)}`;
---
<Base title={title} description={description} active="rankings" jsonLd={isBoard ? faqLd : undefined}>
  {!isBoard ? (
    <!-- ============ HUB ============ -->
    <div class="container">
      <div class="rk-head">
        <div>
          <h1>{tr('Job risk & opportunity rankings', CL)}</h1>
          <p class="subhead">{tr('How exposed is your job to generative AI? Compare salary, workforce size, demand and human resilience across occupations.', CL)} — {countryName(cc, CL)}</p>
        </div>
        <label class="country-select">
          <i class="fas fa-globe"></i>
          <select aria-label={tr('Select country', CL)} onchange="if(this.value)window.location.href=this.value;">
            {COUNTRIES.map((c) => <option value={countryUrl(c)} selected={c === cc}>{countryName(c, CL)}</option>)}
          </select>
        </label>
      </div>

      <div class="board-grid">
        {boardsHub.map((bd) => (
          <div class="board-card">
            <div class="bc-head">
              <span class={`bc-icon tone-${BOARD_TONE[bd.id]}`}><i class={`fas ${BOARD_ICON[bd.id]}`}></i></span>
              <h2>{bd.title}</h2>
              <div class="bc-desc">{bd.desc}</div>
            </div>
            <ol class="rank-list">
              {bd.items.map((it, i) => (
                <li class:list={['rank-item', { top: i === 0 }]}>
                  <span class="rn">{i + 1}</span>
                  <a class="ro" href={hrefJob(loc, it.slug)}>{it.name}</a>
                  <span class="rm">
                    <span class="pm">{primary(bd, it)}</span>
                    {secondary(bd, it) && <span class="sm">{secondary(bd, it)}</span>}
                  </span>
                </li>
              ))}
            </ol>
            <a href={hrefBoard(loc, bd.id, cc)} class="view-full">{tr('View full ranking', CL)} →</a>
          </div>
        ))}
      </div>

      <div class="methodology card">
        <h3>{tr('Data & methodology', CL)}</h3>
        <p>{tr('Exposure scores derive from ILO Working Paper 140 (Gmyrek, Berg & Bescond) and Eloundou et al. "GPTs are GPTs" (OpenAI). Salary, employment and demand data come from official national labour statistics (for the US: BLS OEWS and O*NET). Exposure is a percentile (0–100); labels use fixed thresholds for accessibility. Rankings are computed automatically by transparent rules — not hand-picked.', CL)}</p>
      </div>
    </div>
  ) : (
    <!-- ============ BOARD ============ -->
    <div class="container ri">
      <nav class="breadcrumb"><a href={withL(loc, '/')}>{tr('Home', CL)}</a> <span>/</span> <a href={hrefRankings(loc, cc)}>{tr('Rankings', CL)}</a> <span>/</span> {b!.title}</nav>

      <div class="page-header">
        <h1><i class={`fas ${BOARD_ICON[board!] || 'fa-list-ol'}`}></i> {b!.title}
          <span class="ph-sub">{countryName(cc, CL)} · 2026</span>
        </h1>
        <p class="sub">{b!.desc} · {tr('top', CL)} {b!.items.length} / {fmtNum(dist.total)} {tr('scored occupations', CL)}</p>
        <div class="stats-row">
          <span class="stat-item"><strong>🔴 {tr('High risk', CL)}</strong> {pct(dist.high)}% {tr('of occupations', CL)}</span>
          <span class="stat-item"><strong>🟡 {tr('Moderate', CL)}</strong> {pct(dist.mid)}%</span>
          <span class="stat-item"><strong>🟢 {tr('Low risk', CL)}</strong> {pct(dist.low)}%</span>
          <span class="stat-item"><i class="far fa-calendar"></i> {tr('Updated', CL)} {DATA_UPDATED}</span>
        </div>
      </div>

      <div class="filter-bar">
        <span class="label"><i class="fas fa-filter"></i> {tr('Filter', CL)}:</span>
        <div class="filter-group" id="band-filter">
          <button class="filter-btn active" data-band="all">{tr('All', CL)}</button>
          <button class="filter-btn" data-band="high">{tr('High (70+)', CL)}</button>
          <button class="filter-btn" data-band="mid">{tr('Moderate (40–69)', CL)}</button>
          <button class="filter-btn" data-band="low">{tr('Low (<40)', CL)}</button>
        </div>
        <label class="country-select">
          <i class="fas fa-globe"></i>
          <select aria-label={tr('Select country', CL)} onchange="if(this.value)window.location.href=this.value;">
            {COUNTRIES.map((c) => <option value={countryUrl(c)} selected={c === cc}>{countryName(c, CL)}</option>)}
          </select>
        </label>
        <div class="search-mini">
          <i class="fas fa-search"></i>
          <input type="text" id="ri-search" placeholder={tr('Search occupation…', CL)} aria-label={tr('Search this ranking', CL)} />
        </div>
      </div>

      <div class="rank-table-wrapper">
        <table class="rank-table" id="ri-table"
          data-empty={tr('No occupations match this filter.', CL)}
          data-showing={tr('Showing', CL)}
          data-occ={tr('occupations', CL)}
          data-occ1={tr('occupation', CL)}
          data-nomatch={tr('No occupations match this filter', CL)}>
          <thead>
            <tr>
              <th style="width:48px">#</th>
              <th style="min-width:200px">{tr('Occupation', CL)}</th>
              <th style="min-width:150px">{tr('AI exposure', CL)}</th>
              <th style="min-width:110px">{tr('Human moat', CL)}</th>
              <th style="min-width:100px">{metricCol!.label}</th>
              <th style="width:80px">{tr('Details', CL)}</th>
            </tr>
          </thead>
          <tbody>
            {b!.items.map((it, i) => {
              const tg = tag(it.aioe);
              const mt = moat(it.moat);
              const rank = i + 1;
              return (
                <tr data-band={tg.cls} data-name={it.name.toLowerCase()}>
                  <td class:list={['rank-num', { top1: rank === 1, top2: rank === 2, top3: rank === 3 }]}>{rank}</td>
                  <td data-label={tr('Occupation', CL)}>
                    <span class="job-info">
                      <a class="job-name" href={hrefJob(loc, it.slug)}>{it.name}</a>
                      <span class="job-cat"><i class={`fas ${categoryIcon(it.cat)}`}></i> {tr(it.cat, CL)}</span>
                      <span class={`job-tag ${tg.cls}`}>{tg.label}</span>
                    </span>
                  </td>
                  <td data-label={tr('AI exposure', CL)}>
                    <div class="risk-bar-wrap">
                      <div class="risk-bar-track"><div class="fill" style={`width:${it.aioe ?? 0}%;background:${barColor(it.aioe)}`}></div></div>
                      <span class="risk-pct" style={`color:${pctColor(it.aioe)}`}>{it.aioe ?? '—'}</span>
                    </div>
                  </td>
                  <td data-label={tr('Human moat', CL)}>
                    <span class={`moat-badge ${mt.cls}`}><i class="fas fa-shield-halved"></i> {mt.label}</span>
                  </td>
                  <td data-label={metricCol!.label} class="metric-cell">{metricCol!.fn(it)}</td>
                  <td data-label={tr('Details', CL)}><a href={hrefJob(loc, it.slug)} class="action-link">{tr('View', CL)} →</a></td>
                </tr>
              );
            })}
          </tbody>
        </table>
        <div class="rank-footer">
          <span id="ri-count">{tr('Showing top', CL)} {b!.items.length} / {fmtNum(dist.total)} {tr('occupations', CL)}</span>
          <a class="action-link" href={hrefRankings(loc, cc)}>← {tr('All rankings', CL)}</a>
        </div>
      </div>

      <div class="faq-block">
        <h3><i class="fas fa-circle-question"></i> {tr('About this ranking', CL)}</h3>
        {FAQ.map((f) => (
          <div class="faq-item">
            <div class="q"><i class="fas fa-chevron-right"></i> {f.q}</div>
            <div class="a">{f.a}</div>
          </div>
        ))}
      </div>
    </div>
  )}

  <script is:inline>
    (function () {
      var table = document.getElementById('ri-table');
      if (!table) return;
      var tbody = table.querySelector('tbody');
      var rows = Array.prototype.slice.call(tbody.querySelectorAll('tr'));
      var band = 'all', term = '';
      var count = document.getElementById('ri-count');
      var btns = Array.prototype.slice.call(document.querySelectorAll('#band-filter .filter-btn'));

      // 各档行数：某榜单常常全部集中在一个档（如 least-exposed 全为 low）；
      // 为空的档禁用其筛选按钮，避免点击后得到空表看似出错。
      var counts = { all: rows.length, high: 0, mid: 0, low: 0 };
      rows.forEach(function (r) { var b = r.getAttribute('data-band'); if (counts[b] != null) counts[b]++; });
      btns.forEach(function (btn) {
        var b = btn.getAttribute('data-band');
        if (b !== 'all' && !counts[b]) { btn.disabled = true; btn.classList.add('disabled'); }
      });

      // 空状态占位行（筛选/搜索无结果时提示，而非留白表格）
      var emptyRow = document.createElement('tr');
      emptyRow.id = 'ri-empty';
      emptyRow.style.display = 'none';
      emptyRow.innerHTML = '<td colspan="6" class="ri-empty-cell">' + (table.dataset.empty || 'No occupations match this filter.') + '</td>';
      tbody.appendChild(emptyRow);

      function apply() {
        var shown = 0;
        rows.forEach(function (r) {
          var okBand = band === 'all' || r.getAttribute('data-band') === band;
          var okTerm = !term || r.getAttribute('data-name').indexOf(term) !== -1;
          var show = okBand && okTerm;
          r.style.display = show ? '' : 'none';
          if (show) shown++;
        });
        emptyRow.style.display = shown ? 'none' : '';
        if (count) count.textContent = shown
          ? (table.dataset.showing + ' ' + shown + ' ' + (shown === 1 ? table.dataset.occ1 : table.dataset.occ))
          : table.dataset.nomatch;
      }
      btns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          if (btn.disabled) return;
          btns.forEach(function (x) { x.classList.remove('active'); });
          btn.classList.add('active');
          band = btn.getAttribute('data-band');
          apply();
        });
      });
      var s = document.getElementById('ri-search');
      if (s) s.addEventListener('input', function () { term = s.value.trim().toLowerCase(); apply(); });
    })();
  </script>

  <style>
    /* ===== 共用：国家下拉 ===== */
    .country-select { display: inline-flex; align-items: center; gap: 8px; background: var(--surface);
      border: 1px solid var(--line); border-radius: 12px; padding: 8px 14px; box-shadow: var(--shadow); }
    .country-select i { color: var(--text-muted); }
    .country-select select { border: none; background: transparent; font: inherit; color: var(--text-strong); font-weight: 500; cursor: pointer; outline: none; }

    /* ===== HUB ===== */
    .rk-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 18px; padding: 40px 0 26px; }
    .rk-head h1 { font-size: clamp(1.9rem, 4vw, 2.5rem); margin: 0; }
    .subhead { color: var(--text-muted); max-width: 640px; margin: 8px 0 0; }
    .board-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 20px; margin-bottom: 40px; }
    .board-card { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 20px; box-shadow: var(--shadow); display: flex; flex-direction: column; }
    .bc-head { margin-bottom: 10px; }
    .bc-icon { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 9px; margin-bottom: 8px; font-size: 0.95rem; }
    .tone-high { background: var(--risk-high-bg); color: var(--risk-high); }
    .tone-low { background: var(--risk-low-bg); color: var(--risk-low); }
    .tone-gold { background: var(--gold-bg); color: var(--gold-fg); }
    .tone-slate { background: var(--slate-bg); color: var(--slate-fg); }
    .tone-brand { background: var(--brand-tint); color: var(--brand); }
    .tone-moat { background: var(--accent-purple-bg); color: var(--accent-purple); }
    .bc-head h2 { font-size: 1.15rem; margin: 4px 0 2px; }
    .bc-desc { font-size: 0.8rem; color: var(--text-muted); }
    .rank-list { list-style: none; margin: 10px 0 0; padding: 0; flex: 1; display: flex; flex-direction: column; gap: 4px; }
    .rank-item { display: flex; align-items: baseline; gap: 12px; padding: 7px 10px; border-radius: 8px; }
    .rank-item.top { background: var(--surface-tint-2); border-left: 3px solid var(--brand); }
    .rn { min-width: 20px; text-align: right; font-size: 0.82rem; font-weight: 600; color: var(--text-muted); }
    .rank-item.top .rn { color: var(--brand); }
    .ro { flex: 1; font-size: 0.92rem; color: var(--text-strong); font-weight: 500; }
    .ro:hover { color: var(--brand); }
    .rm { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
    .pm { display: block; font-weight: 600; font-size: 0.9rem; color: var(--text); }
    .sm { display: block; font-size: 0.72rem; color: var(--text-muted); }
    .view-full { margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--line); font-size: 0.82rem; font-weight: 600; }
    .methodology { margin-bottom: 20px; }
    .methodology h3 { margin: 0 0 6px; }
    .methodology p { font-size: 0.86rem; color: var(--text-muted); margin: 0; max-width: 860px; }

    /* ===== BOARD ===== */
    .ri { padding-bottom: 12px; }
    .breadcrumb { font-size: 0.85rem; color: var(--text-muted); margin: 18px 0 12px; display: flex; gap: 6px; }
    .breadcrumb a { color: var(--brand); } .breadcrumb a:hover { text-decoration: underline; }

    .page-header { background: linear-gradient(145deg, var(--surface) 0%, var(--surface-tint-2) 100%);
      border: 1px solid var(--line); border-radius: 28px; padding: 30px 36px; margin-bottom: 24px; }
    .page-header h1 { font-size: clamp(1.6rem, 3.5vw, 2.1rem); font-weight: 700; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin: 0; }
    .page-header h1 i { color: var(--brand); }
    .ph-sub { font-size: 1rem; font-weight: 400; color: var(--text-muted); }
    .page-header .sub { color: var(--text-body); margin-top: 8px; font-size: 1rem; }
    .stats-row { display: flex; flex-wrap: wrap; gap: 16px 44px; margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--line); }
    .stat-item { font-size: 0.86rem; color: var(--text-muted); }
    .stat-item strong { color: var(--text); font-weight: 700; }

    .filter-bar { display: flex; flex-wrap: wrap; gap: 12px 18px; align-items: center;
      background: var(--surface); border: 1px solid var(--line); border-radius: 18px; padding: 14px 20px; margin-bottom: 24px; }
    .filter-bar .label { font-weight: 500; color: var(--text-muted); font-size: 0.86rem; }
    .filter-group { display: flex; flex-wrap: wrap; gap: 8px; }
    .filter-btn { padding: 6px 16px; border-radius: 40px; border: 1px solid var(--line); background: var(--surface);
      font-size: 0.84rem; font-weight: 500; color: var(--text-strong); cursor: pointer; transition: .1s; font-family: inherit; }
    .filter-btn.active { background: var(--brand); color: #fff; border-color: var(--brand); }
    .filter-btn:hover:not(.active):not(:disabled) { border-color: var(--brand); background: var(--surface-tint-2); }
    .filter-btn:disabled { opacity: .4; cursor: not-allowed; }
    .ri-empty-cell { padding: 30px 20px; text-align: center; color: var(--text-muted); font-size: 0.92rem; }
    .filter-bar .country-select { border-radius: 40px; padding: 5px 14px; box-shadow: none; }
    .search-mini { margin-left: auto; display: flex; align-items: center; gap: 6px; background: var(--bg);
      padding: 4px 16px 4px 12px; border-radius: 40px; border: 1px solid var(--line); }
    .search-mini i { color: var(--text-muted); }
    .search-mini input { border: none; background: transparent; padding: 6px 0; font-size: 0.86rem; outline: none; width: 150px; color: var(--text); }

    /* 不设 overflow（会困住 sticky）；表头滚动置顶到 nav（64px）下方 */
    .rank-table-wrapper { background: var(--surface); border: 1px solid var(--line); border-radius: 22px; margin-bottom: 28px; box-shadow: var(--shadow); }
    .rank-table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
