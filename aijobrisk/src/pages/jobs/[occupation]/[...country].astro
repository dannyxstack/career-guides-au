---
import Base from '../../../layouts/Base.astro';
import RatingRadar from '../../../components/RatingRadar.astro';
import PollBlock from '../../../components/PollBlock.astro';
import {
  jobBySlug, occFull, name as occName, tr, money, currencyOf, countryName,
  COUNTRY_FLAG, radarLabels, radarValues, sourcesBody, migRestrictedOccOf, migRestrictedNoteOf,
  nonMigVisaOf, disType, disLevel,
} from '../../../lib/data';
import { pageLocale, contentLocale, hrefJob, hrefMap, hrefIndustries, withL } from '../../../lib/i18n';
import { expBand, riskBand10, fmtSalary, fmtNum } from '../../../lib/ui';
import { DATA_UPDATED, NETWORK } from '../../../lib/site-config';
import faq2030 from '../../../data/faq_2030.json';

const loc = pageLocale(Astro);
const CL = contentLocale(loc);

const { occupation: slug, country } = Astro.params;
const group = slug ? jobBySlug(slug) : null;
if (!group) return new Response('Not found', { status: 404 });

const rep = await occFull(group.rep);
const ai = rep.ai;
const nm = rep.name_en;
const dispName = occName(rep, CL);
const countries = await Promise.all(group.countries.map((o) => occFull(o)));

const active = country && countries.some((o) => o.country === country)
  ? countries.find((o) => o.country === country)!
  : countries[0];
const cc = active.country;
const cur = active.currency || currencyOf(cc);

// —— 风险刻度 ——
const exposure = ai?.automation_exposure ?? null;          // 10 分制
const moat = ai?.human_moat ?? null;
const entry = ai?.entry_risk ?? null;
const upside = ai?.ai_upside ?? null;
const aioe = ai?.aioe_pct ?? null;                          // 0-100 百分位
const band = aioe != null ? expBand(aioe) : riskBand10(exposure);
const headlinePct = aioe != null ? aioe : (exposure != null ? Math.round(exposure * 10) : null);

const catName = rep.category;
const catUrl = hrefIndustries(loc);
const verdict = ai ? tr(ai.verdict_zh, CL) : tr('There is not enough evidence for a reliable conclusion yet.', CL);
// risk-meter 概要三连（job-detail.html 风格）：替代 / 增强 / 护城河 各取首项
const firstReplaced = ai?.replaced_zh?.[0] ? tr(ai.replaced_zh[0], CL) : null;
const firstAugmented = ai?.augmented_zh?.[0] ? tr(ai.augmented_zh[0], CL) : null;
const firstMoat = ai?.moat_zh?.[0] ? tr(ai.moat_zh[0], CL) : null;

// 国家面板正文
const z = active.i18n?.['zh-CN'] || ({} as any);
const trend = tr(z.trend_summary, CL);
const forecast = tr(z.forecast_note, CL);
const radar = [{ name: nm, color: '#2563eb', values: radarValues(active) }];

// —— 通用「2030 年」FAQ 问答：按 nav 当前语言取（faq_2030 覆盖 8 种显示语言），问句与答案模板均本地化，
//    答案由本地化片段拼装并注入真实数字（{name}/{level}/{moat}），不再泄漏英文 verdict。——
const fill = (tpl: string) => tpl.replace('{name}', dispName);
const F = faq2030 as Record<string, Record<string, any>>;
const pick = (obj: Record<string, any>) => obj[loc] ?? obj.en;
const q2030 = fill(pick(F.q));
const lvlLabel = (pick(F.label)?.[band.cls]) || band.label;
const level = aioe != null ? `${lvlLabel} (${aioe}/100)`
  : exposure != null ? `${lvlLabel} (${exposure.toFixed(1)}/10)` : lvlLabel;
const a2030 = fill(pick(F.a1)).replace('{level}', level)
  + (moat != null ? pick(F.aMoat).replace('{moat}', moat.toFixed(1)) : '')
  + pick(F.a2);

const title = `${tr('Will AI replace', CL)} ${dispName}? — ${tr('AI risk, salary & outlook', CL)} | AI Job Risk`;
const desc = `${tr('AI replacement risk, task exposure and the human moat for this occupation, plus local salary, licensing and outlook.', CL)} — ${dispName}`;
const jobLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: q2030, acceptedAnswer: { '@type': 'Answer', text: a2030 } },
    ...(active.faqs || []).slice(0, 6).map((f: any) => ({
      '@type': 'Question', name: tr(f.question, CL),
      acceptedAnswer: { '@type': 'Answer', text: tr(f.answer, CL) },
    })),
  ],
};
---
<Base title={title} description={desc} active="occupations" jsonLd={(active.faqs || []).length ? jobLd : undefined}>
  <div class="container jd">
    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label={tr('Breadcrumb', CL)}>
      <a href={withL(loc, '/')}>{tr('Home', CL)}</a> <span>›</span> <a href={catUrl}>{tr(catName, CL)}</a> <span>›</span> <span>{dispName}</span>
    </nav>

    <!-- ===== 第一屏：job-detail.html 风格的 detail-section 卡片 ===== -->
    <section class="detail-section">
      <div class="detail-header">
        <div class="title-group">
          <h1>{dispName}{dispName !== nm && <span class="latin">{nm}</span>}</h1>
          <span class="country-pill"><i class="fas fa-clock-rotate-left"></i> {tr('Occupation baseline · updated', CL)} {DATA_UPDATED}</span>
          <div class="meta-pills">
            <span class="pill"><i class="fas fa-industry"></i> {tr(catName, CL)}</span>
            <span class="pill"><i class="fas fa-hashtag"></i> {active.anzsco_code || active.occ_code || '—'} ({active.occ_code_type})</span>
            <span class="pill"><i class="fas fa-globe"></i> {countries.length} {tr('countries', CL)}</span>
          </div>
        </div>
        {headlinePct != null && (
          <div class={`risk-badge-lg ${band.cls}`}>
            {headlinePct}<small>{tr('AI exposure', CL)} · {tr(band.label, CL)}</small>
          </div>
        )}
      </div>

      {headlinePct != null && (
        <div class="risk-meter">
          <div class="meter-visual">
            <span class="meter-label">{tr('AI exposure', CL)}{aioe != null && <small class="meter-src"> (GenAI · ILO / OpenAI)</small>}</span>
            <div class="meter-bar"><div class="fill" style={`width:${Math.min(headlinePct, 100)}%`}></div></div>
            <span class="meter-num">{headlinePct}<small>{aioe != null ? '/100' : '%'}</small></span>
            <span class={`risk-badge ${band.cls}`}>{tr(band.label, CL)}</span>
          </div>
          <div class="risk-summary">
            {firstReplaced && <span class="rs-pill"><i class="fas fa-circle-xmark" style="color:var(--risk-high)"></i> <b>{tr('Replaces:', CL)}</b> {firstReplaced}</span>}
            {firstAugmented && <span class="rs-pill"><i class="fas fa-circle-check" style="color:var(--risk-low)"></i> <b>{tr('Augments:', CL)}</b> {firstAugmented}</span>}
            {firstMoat && <span class="rs-pill"><i class="fas fa-shield-halved" style="color:var(--brand)"></i> <b>{tr('Moat:', CL)}</b> {firstMoat}</span>}
          </div>
          {aioe != null && (
            <p class="muted meter-pct">{tr('More exposed than about', CL)} {aioe}% {tr('of occupations (percentile; higher = more exposed to generative AI).', CL)}</p>
          )}
        </div>
      )}

      <p class="verdict"><strong>{tr(band.label, CL)} {tr('exposure', CL)}.</strong> {verdict}</p>
      <p class="muted scope">{tr('Occupation-level baseline, not a personal prediction. Local salary, licensing and outlook are shown by country below.', CL)}</p>

      <div class:list={['scores', headlinePct != null ? band.cls : null]}>
        <div><span>{tr('Task exposure', CL)}</span><b>{exposure != null ? `${exposure.toFixed(1)}/10` : '—'}</b></div>
        <div><span>{tr('Human moat', CL)}</span><b>{moat != null ? `${moat.toFixed(1)}/10` : '—'}</b></div>
        <div><span>{tr('Entry pressure', CL)}</span><b>{entry != null ? `${entry.toFixed(1)}/10` : '—'}</b></div>
        <div><span>{tr('AI upside', CL)}</span><b>{upside != null ? `${upside.toFixed(1)}/10` : '—'}</b></div>
      </div>

      <div class="actions">
        <a class="btn primary" href={NETWORK.assessment}><i class="fas fa-user-check"></i> {tr('Check my personal resilience', CL)}</a>
        <a class="btn" href={hrefMap(loc)}><i class="fas fa-map"></i> {tr('Compare on the risk map', CL)}</a>
      </div>
    </section>

    <!-- Global AI zone -->
    {ai && (
      <section class="ai-zone">
        <div class="ai-grid">
          <div class="card ai-tint-red"><h4 class="amber"><i class="fas fa-minus-circle"></i> {tr('Tasks AI will take over', CL)}</h4>
            <ul class="dash">{(ai.replaced_zh || []).map((x) => <li>{tr(x, CL)}</li>)}</ul></div>
          <div class="card ai-tint-green"><h4 class="green"><i class="fas fa-plus-circle"></i> {tr('Tasks AI will augment', CL)}</h4>
            <ul class="dash">{(ai.augmented_zh || []).map((x) => <li>{tr(x, CL)}</li>)}</ul></div>
          <div class="card moat"><h4 class="moat-h"><i class="fas fa-chess-king"></i> {tr('Human moat (hard for AI)', CL)}</h4>
            <ul class="dash">{(ai.moat_zh || []).map((x) => <li>{tr(x, CL)}</li>)}</ul></div>
          <div class="card ai-tint-blue"><h4><i class="fas fa-graduation-cap"></i> {tr('Skills to build (next 5 years)', CL)}</h4>
            <ul class="dash">{(ai.skills_zh || []).map((x) => <li>{tr(x, CL)}</li>)}</ul></div>
        </div>

        <div class="ai-notes">
          {ai.entry_narrowing_zh && (
            <div class="card ai-tint-slate"><h4><i class="fas fa-door-closed"></i> {tr('Entry-level outlook', CL)}</h4>
              <p class="muted">{tr(ai.entry_narrowing_zh, CL)}</p></div>
          )}
          {ai.upgrade_path_zh && (
            <div class="card ai-tint-green"><h4 class="green"><i class="fas fa-rocket"></i> {tr('How to level up in the AI era', CL)}</h4>
              <p>{tr(ai.upgrade_path_zh, CL)}</p></div>
          )}
        </div>

        {(ai as any).disruptors && (ai as any).disruptors.length > 0 && (
          <div class="card"><h4 class="amber"><i class="fas fa-robot"></i> {tr('AI already affecting this job', CL)}</h4>
            <ul class="disruptors">{(ai as any).disruptors.map((d: any) => (
              <li class="dis">
                <div class="dis-head">
                  {d.url ? <a class="dis-name" href={d.url} target="_blank" rel="noopener nofollow">{d.name}</a> : <span class="dis-name">{d.name}</span>}
                  <span class="risk-badge verylow">{disType(d.type, CL)}</span>
                  <span class={`risk-badge ${d.level === 'full' ? 'high' : d.level === 'major' ? 'moderate' : 'low'}`}>{disLevel(d.level, CL)}</span>
                  {d.year && <span class="muted dis-year">{d.year}</span>}
                </div>
                {d.scope_zh && <p class="muted dis-scope">{tr(d.scope_zh, CL)}</p>}
              </li>
            ))}</ul></div>
        )}

        {(ai as any).adjacent && (ai as any).adjacent.length > 0 && (
          <div class="card ai-tint-blue"><h4><i class="fas fa-arrow-right-arrow-left"></i> {tr('Adjacent careers if risk is high', CL)}</h4>
            <div class="adjacent">{(ai as any).adjacent.map((j: any) => (
              <a class="adj-chip" href={hrefJob(loc, j.slug)}>{occName(jobBySlug(j.slug)?.rep || ({} as any), CL) || j.name_en}</a>
            ))}</div></div>
        )}
      </section>
    )}

    <!-- Country tabs -->
    <h2 class="by-country">{tr('Local data by country', CL)}</h2>
    <div class="tabs" role="tablist">
      {countries.map((o) => (
        <a class:list={['tab', { on: o.country === cc }]} role="tab" aria-selected={o.country === cc ? 'true' : 'false'}
           href={hrefJob(loc, slug!, o.country)}>
          <span class="flag" set:html={COUNTRY_FLAG[o.country]} />{countryName(o.country, CL)}
        </a>
      ))}
    </div>

    <!-- Active country panel -->
    <section class="panel">
      <div class="panel-stats">
        {active.overall_score != null && <span class="pstat">{tr('Overall', CL)} <b>{active.overall_score}/10</b></span>}
        {active.workforce_size != null && <span class="pstat">{tr('Workforce', CL)} <b>{fmtNum(active.workforce_size)}</b></span>}
        {active.avg_salary != null && <span class="pstat">{tr('Avg salary', CL)} <b>{fmtSalary(active.avg_salary, cc)}</b></span>}
        {active.is_migration === 1 ? <span class="risk-badge low">{tr('Skilled migration occupation', CL)}</span>
          : active.is_migration === 2 ? <span class="risk-badge moderate">{migRestrictedOccOf(cc, CL)}</span>
          : <span class="risk-badge verylow">{tr('Not a skilled migration occupation', CL)}</span>}
      </div>

      <div class="two-col">
        <div class="col">
          <h3><i class="fas fa-chart-simple"></i> {tr('Ratings', CL)}{active.overall_score != null ? ` · ${tr('Overall', CL)} ${active.overall_score}/10` : ''}</h3>
          <RatingRadar labels={radarLabels(CL)} series={radar} max={10} ariaLabel={tr('rating radar', CL)} />
        </div>
        <div class="col">
          <h3><i class="fas fa-dollar-sign"></i> {tr('Salary', CL)} ({cur})</h3>
          <table>
            <thead><tr><th>{tr('Experience', CL)}</th><th>{tr('Annual', CL)}</th><th></th></tr></thead>
            <tbody>{active.salaries.map((s: any) => (
              <tr><td>{tr(s.label, CL)}</td><td class="amber pay">{money(s.min, cc)} ~ {money(s.max, cc)}</td><td class="muted">{tr(s.note, CL)}</td></tr>
            ))}</tbody>
          </table>
        </div>
      </div>

      {active.education.length > 0 && (
        <>
          <h3><i class="fas fa-graduation-cap"></i> {tr('Education path', CL)}</h3>
          <table>
            <thead><tr><th>{tr('Stage', CL)}</th><th>{tr('Duration', CL)}</th><th>{tr('Cost', CL)} ({cur})</th></tr></thead>
            <tbody>{active.education.map((e: any) => (
              <tr><td>{tr(e.stage, CL)}</td><td>{tr(e.duration, CL) || '—'}</td>
                <td>{e.cost_min ? `${money(e.cost_min, cc)} ~ ${money(e.cost_max, cc)}` : (tr(e.cost_note, CL) || '—')}</td></tr>
            ))}</tbody>
          </table>
        </>
      )}

      {active.qualifications && active.qualifications.length > 0 && (
        <>
          <h3><i class="fas fa-certificate"></i> {tr('Qualifications', CL)}</h3>
          <table>
            <thead><tr><th>{tr('Qualification', CL)}</th><th>{tr('Issuer', CL)}</th><th></th></tr></thead>
            <tbody>{active.qualifications.map((q: any) => (
              <tr><td>{tr(q.name, CL)}</td><td class="muted">{tr(q.issuer, CL) || '—'}</td>
                <td>{q.mandatory ? <span class="risk-badge low">{tr('Required', CL)}</span> : <span class="risk-badge verylow">{tr('Optional', CL)}</span>}</td></tr>
            ))}</tbody>
          </table>
        </>
      )}

      <h3><i class="fas fa-passport"></i> {tr('Migration', CL)} ({tr('to', CL)} {countryName(cc, CL)})</h3>
      {active.is_migration ? (
        <>
          {active.is_migration === 2 && <p class="card muted note">⚠ {migRestrictedNoteOf(cc, CL)}</p>}
          <table>
            <thead><tr><th>{tr('Visa', CL)}</th><th>{tr('Details', CL)}</th></tr></thead>
            <tbody>{(active.visa || []).map((v: any) => (
              <tr><td><strong>{v.subclass}</strong> {tr(v.name, CL)}</td>
                <td class="muted">{tr(v.desc, CL)}{v.min_score ? ` · ~${v.min_score} ${tr('pts competitive cut-off', CL)} (${v.score_asof || ''}, ${tr('indicative', CL)})` : ''}</td></tr>
            ))}</tbody>
          </table>
        </>
      ) : (
        <p class="card muted">{tr('Not a skilled migration occupation.', CL)} {nonMigVisaOf(cc, CL)}</p>
      )}

      {(active.suitability?.fit?.length > 0 || active.suitability?.unfit?.length > 0) && (
        <>
          <h3><i class="fas fa-user-check"></i> {tr('Who it fits', CL)}</h3>
          <div class="two-col">
            <div class="card"><h4 class="green">✓ {tr('Fits', CL)}</h4><ul class="dash">{(active.suitability.fit || []).map((x: string) => <li>{tr(x, CL)}</li>)}</ul></div>
            <div class="card"><h4 class="amber">✗ {tr('Not for', CL)}</h4><ul class="dash">{(active.suitability.unfit || []).map((x: string) => <li>{tr(x, CL)}</li>)}</ul></div>
          </div>
        </>
      )}

      {(trend || forecast || active.growth_areas?.length > 0) && (
        <>
          <h3><i class="fas fa-arrow-trend-up"></i> {tr('Career outlook', CL)}</h3>
          {trend && <p>{trend}</p>}
          {forecast && <p class="muted">{forecast}</p>}
          {active.growth_areas && active.growth_areas.length > 0 && (
            <p class="growth-tags">{active.growth_areas.map((g: string) => <span class="risk-badge verylow gt">{g}</span>)}</p>
          )}
        </>
      )}

      <h3><i class="fas fa-circle-question"></i> {tr('FAQ', CL)} · {dispName}</h3>
      <details class="faq-item" open>
        <summary>{q2030}<i class="fas fa-chevron-down"></i></summary>
        <div class="faq-answer">
          <p>{a2030}</p>
        </div>
      </details>
      {(active.faqs || []).map((f: any) => (
        <details class="faq-item"><summary>{tr(f.question, CL)}<i class="fas fa-chevron-down"></i></summary>
          <div class="faq-answer">{tr(f.answer, CL)}</div></details>
      ))}

      <h3><i class="fas fa-database"></i> {tr('Data sources', CL)}</h3>
      <p class="card muted note">{sourcesBody(cc, CL)}</p>
    </section>

    <PollBlock slug={slug!} locale={CL} name={dispName} baked={(rep as any).polls} />
  </div>

  <style>
    .jd { padding-bottom: 20px; }
    .breadcrumb { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; padding: 18px 0 8px;
      font-size: 0.85rem; color: var(--text-muted); }
    .breadcrumb a { color: var(--text-muted); } .breadcrumb a:hover { color: var(--brand); }
    .breadcrumb span { color: var(--text-muted); }

    /* ===== 第一屏 detail-section（job-detail.html 风格） ===== */
    .detail-section { background: var(--surface); border: 1px solid var(--line); border-radius: 28px;
      padding: 32px 36px; box-shadow: var(--shadow); margin: 10px 0 32px; }
    .detail-header { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start;
      gap: 20px; border-bottom: 1px solid var(--line); padding-bottom: 24px; margin-bottom: 24px; }
    .title-group h1 { font-size: clamp(1.8rem, 4vw, 2.3rem); margin: 0; letter-spacing: -0.02em; line-height: 1.15; }
    .title-group h1 .latin { font-weight: 400; font-size: 0.62em; color: var(--text-body); margin-left: 8px; }
    .country-pill { display: inline-block; margin-top: 8px; font-size: 0.82rem; color: var(--text-strong);
      background: var(--surface-tint-2); padding: 4px 16px; border-radius: 40px; }
    .country-pill i { margin-right: 6px; color: var(--brand); }
    .meta-pills { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
    .pill { background: var(--brand-tint); color: var(--text-strong); padding: 4px 14px; border-radius: 40px; font-size: 0.78rem; font-weight: 500; }
    .pill i { margin-right: 5px; color: var(--brand); }
    .risk-badge-lg { flex: none; text-align: center; padding: 12px 28px; border-radius: 60px; font-size: 2.4rem; font-weight: 700; line-height: 1.1; }
    .risk-badge-lg small { display: block; font-size: 0.78rem; font-weight: 500; opacity: .9; margin-top: 2px; }
    .risk-badge-lg.high, .risk-badge-lg.critical { background: var(--risk-high-bg); color: var(--risk-high-fg); }
    .risk-badge-lg.moderate { background: var(--risk-mid-bg); color: var(--risk-mid-fg); }
    .risk-badge-lg.low, .risk-badge-lg.verylow { background: var(--risk-low-bg); color: var(--risk-low-fg); }

    .risk-meter { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 40px;
      background: var(--bg-soft); border: 1px solid var(--line); padding: 18px 24px; border-radius: 20px; margin-bottom: 24px; }
    .meter-visual { display: flex; align-items: center; gap: 14px; }
    .meter-label { font-weight: 600; font-size: 1rem; color: var(--text-strong); }
    .meter-bar { width: 200px; height: 12px; background: var(--surface-tint); border-radius: 40px; overflow: hidden; }
    .meter-bar .fill { height: 100%; background: linear-gradient(90deg, #f59e0b, #dc2626); border-radius: 40px; }
    .meter-num { font-weight: 700; font-size: 1.25rem; color: var(--text); }
    .meter-num small { font-size: 0.8rem; font-weight: 500; color: var(--text-muted); }
    .meter-src { font-weight: 500; font-size: 0.72rem; color: var(--text-muted); }
    .meter-pct { flex-basis: 100%; margin: 0; font-size: 0.8rem; }
    .risk-summary { display: flex; flex-wrap: wrap; gap: 10px; flex: 1; }
    .rs-pill { background: var(--surface); border: 1px solid var(--line); border-radius: 40px;
      padding: 6px 16px; font-size: 0.82rem; color: var(--text-body); max-width: 100%; }
    .rs-pill i { margin-right: 6px; } .rs-pill b { color: var(--text-strong); font-weight: 600; }

    .verdict { font-size: 1.1rem; margin: 0 0 6px; }
    .scope { font-size: 0.85rem; margin: 0 0 18px; }
    .scores { display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
    /* scores 淡背景：与 risk-badge-lg 同色系但更淡（-bg 再混入更多 surface） */
    .scores.high, .scores.critical { background: color-mix(in srgb, var(--risk-high-bg) 45%, var(--surface)); }
    .scores.moderate { background: color-mix(in srgb, var(--risk-mid-bg) 45%, var(--surface)); }
    .scores.low, .scores.verylow { background: color-mix(in srgb, var(--risk-low-bg) 45%, var(--surface)); }
    .scores > div { padding: 12px 16px; border-right: 1px solid var(--line); }
    .scores > div:last-child { border-right: none; }
    .scores span { display: block; color: var(--text-muted); font-size: 0.75rem; }
    .scores b { display: block; margin-top: 2px; font-size: 1.15rem; color: var(--text-strong); }
    .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 20px; }

    .ai-zone { display: flex; flex-direction: column; gap: 16px; margin: 8px 0 28px; }
    .ai-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .ai-notes { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
