---
import Base from '../../layouts/Base.astro';
import { COMPARE_PAIRS, pairKey, jobBySlug, JOB_SLUGS, name as occName, countryName, CURRENCY, COUNTRIES } from '../../lib/data';
import { categoryIcon } from '../../lib/industries';
import { pageLocale, contentLocale, hrefCompare } from '../../lib/i18n';
import { expBand, fmtSalary } from '../../lib/ui';

const loc = pageLocale(Astro);
const CL = contentLocale(loc);

// 全量职业（按 slug 去重）供可搜索下拉：{s:slug, n:name, e:aioe暴露, c:分类,
//   sal:{国家码→年薪}}。sal 让用户在选择框里按不同国家比较（暴露 e 为跨国一致，不随国家变）。
const OCCS = JOB_SLUGS.map((s) => {
  const g = jobBySlug(s)!;
  const r = g.rep;
  const sal: Record<string, number> = {};
  for (const o of g.countries) if (o.avg_salary != null) sal[o.country] = Math.round(Number(o.avg_salary));
  return {
    s, n: occName(r, CL),
    e: r.ai?.aioe_pct ?? null,
    c: r.category || '',
    sal,
  };
}).filter((o) => o.n).sort((a, b) => a.n.localeCompare(b.n));

// 国家码→本币 + 显示名（client 端下拉/货币格式化用，体积很小）
const CTRY_META: Record<string, { cur: string; name: string }> = {};
for (const c of COUNTRIES) CTRY_META[c] = { cur: CURRENCY[c] || 'USD', name: countryName(c, CL) };

// 默认预选：首个热门对
const def = COMPARE_PAIRS[0] || [OCCS[0]?.s, OCCS[1]?.s];
const defA = def[0], defB = def[1];

// 热门对（名称 + 暴露）
const pairs = COMPARE_PAIRS.map(([a, b]) => {
  const oa = jobBySlug(a)!, ob = jobBySlug(b)!;
  return { key: pairKey(a, b), a: occName(oa.rep, CL), b: occName(ob.rep, CL),
    ea: oa.rep.ai?.aioe_pct ?? null, eb: ob.rep.ai?.aioe_pct ?? null };
});

const FAQ = [
  { q: 'How does the comparison work?', a: 'We combine occupation-level data from national labour statistics with generative-AI exposure scores from ILO Working Paper 140 and Eloundou et al. (OpenAI). Each occupation is scored on a 0–100 exposure percentile based on task overlap with large language models.' },
  { q: 'What does the AI exposure score mean?', a: 'A low percentile means minimal exposure (tasks unlikely to be automated or augmented by AI); a high percentile means near-full exposure. Scores reflect the share of tasks that could be affected by current generative AI, not job elimination.' },
  { q: 'Where does the data come from?', a: 'Official sources include the U.S. Bureau of Labor Statistics, UK ONS, Australia Jobs and Skills, Germany BA and others. AI-exposure research is drawn from the ILO working paper and Eloundou et al. Figures are estimates and indicative only.' },
  { q: 'Can I trust the risk labels?', a: 'Risk labels (low/moderate/high) always appear alongside the numeric score and a text description — colour is never the sole indicator. The full methodology is documented on the Methodology page.' },
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const comparePrefix = hrefCompare(loc) + '/';
---
<Base
  title="Compare occupations side by side — AI risk, salary & outlook | AI Job Risk"
  description="Compare two occupations: AI exposure, salary and the human moat, built on official labour statistics and AI-exposure research."
  active="compare"
  jsonLd={faqLd}
>
  <div class="container cmp-hub">
    <section class="hero">
      <h1>Compare occupations side by side</h1>
      <p class="subhead">AI exposure, salary and the human moat across {JOB_SLUGS.length.toLocaleString('en')} occupations — built on official labour statistics and AI-exposure research. Search any two jobs to compare.</p>

      <div class="selectors">
        <!-- Selector A -->
        <div class="selector-card">
          <span class="selector-label">Occupation A</span>
          <div class="combobox" data-side="a">
            <input type="text" class="cb-input" role="combobox" aria-expanded="false" aria-label="Search first occupation" placeholder="Search an occupation…" autocomplete="off" />
            <ul class="cb-list" role="listbox" hidden></ul>
          </div>
          <div class="cb-country-row" data-side="a" hidden>
            <i class="fas fa-globe"></i>
            <select class="cb-country" data-side="a" aria-label="Country for occupation A"></select>
          </div>
          <span class="cat-tag" data-side="a"></span>
          <div class="preview-line">
            <span class="risk-badge" data-side="a-badge"></span>
            <span class="pv-salary" data-side="a-salary"></span>
          </div>
        </div>

        <!-- swap -->
        <div class="vs-divider">
          <button type="button" class="vs-circle" id="cmp-swap" aria-label="Swap occupations"><i class="fas fa-right-left"></i></button>
        </div>

        <!-- Selector B -->
        <div class="selector-card">
          <span class="selector-label">Occupation B</span>
          <div class="combobox" data-side="b">
            <input type="text" class="cb-input" role="combobox" aria-expanded="false" aria-label="Search second occupation" placeholder="Search an occupation…" autocomplete="off" />
            <ul class="cb-list" role="listbox" hidden></ul>
          </div>
          <div class="cb-country-row" data-side="b" hidden>
            <i class="fas fa-globe"></i>
            <select class="cb-country" data-side="b" aria-label="Country for occupation B"></select>
          </div>
          <span class="cat-tag" data-side="b"></span>
          <div class="preview-line">
            <span class="risk-badge" data-side="b-badge"></span>
            <span class="pv-salary" data-side="b-salary"></span>
          </div>
        </div>
      </div>

      <div class="cta-row">
        <a class="btn primary" id="cmp-go" href="#"><span>Compare these jobs</span> <i class="fas fa-arrow-right"></i></a>
        <span class="muted small">Live preview below · full breakdown on the comparison page.</span>
      </div>

      <div class="metric-tiles">
        <div class="metric-tile">
          <span class="mt-label">AI exposure percentile</span>
          <div class="mt-cmp"><span class="mt-val a" data-side="a-exp">—</span><span class="mt-sep">vs</span><span class="mt-val b" data-side="b-exp">—</span></div>
          <span class="mt-note" data-side="exp-note"></span>
        </div>
        <div class="metric-tile">
          <span class="mt-label">Average salary</span>
          <div class="mt-cmp"><span class="mt-val a" data-side="a-pay">—</span><span class="mt-sep">vs</span><span class="mt-val b" data-side="b-pay">—</span></div>
          <span class="mt-note" data-side="pay-note"></span>
        </div>
      </div>
    </section>

    <section class="popular-section">
      <h2>Popular comparison pairs</h2>
      <div class="popular-grid">
        {pairs.map((p) => (
          <a class="popular-card" href={`${comparePrefix}${p.key}`}>
            <span class="pair">{p.a} <span class="pv">vs</span> {p.b}</span>
            <span class="pair-stat">AI exposure {p.ea != null && <b class={expBand(p.ea).cls}>{p.ea}</b>} vs {p.eb != null && <b class={expBand(p.eb).cls}>{p.eb}</b>}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="faq-section">
      <h2>Frequently asked questions</h2>
      <div class="faq-list">
        {FAQ.map((f) => (
          <details class="faq-item"><summary>{f.q}<i class="fas fa-chevron-down"></i></summary>
            <div class="faq-answer">{f.a}</div></details>
        ))}
      </div>
    </section>
  </div>

  <script type="application/json" id="cmp-occs" set:html={JSON.stringify(OCCS)}></script>
  <script type="application/json" id="cmp-ctry" set:html={JSON.stringify(CTRY_META)}></script>
  <script is:inline define:vars={{ defA, defB, comparePrefix }}>
    (function () {
      var OCCS = JSON.parse(document.getElementById('cmp-occs').textContent || '[]');
      var CTRY = JSON.parse(document.getElementById('cmp-ctry').textContent || '{}');
      var byslug = {}; OCCS.forEach(function (o) { byslug[o.s] = o; });
      function fmtMoney(v, cur) {
        if (v == null) return '—';
        try { return new Intl.NumberFormat('en', { style: 'currency', currency: cur || 'USD', maximumFractionDigits: 0 }).format(v); }
        catch (e) { return String(Math.round(v)); }
      }
      function band(e) {
        if (e == null) return { cls: 'verylow', label: 'n/a' };
        if (e >= 85) return { cls: 'critical', label: 'very high' };
        if (e >= 70) return { cls: 'high', label: 'high' };
        if (e >= 40) return { cls: 'moderate', label: 'moderate' };
        if (e >= 20) return { cls: 'low', label: 'low' };
        return { cls: 'verylow', label: 'very low' };
      }
      // 该职业有薪资数据的国家（下拉选项）；第一项作为默认国家
      function ccKeys(o) { return o && o.sal ? Object.keys(o.sal) : []; }
      function firstCC(o) { var k = ccKeys(o); return k.length ? k[0] : null; }

      var sel = { a: byslug[defA] || OCCS[0], b: byslug[defB] || OCCS[1] };
      var selCC = { a: firstCC(sel.a), b: firstCC(sel.b) };
      function salOf(side) { var o = sel[side], cc = selCC[side]; return (o && cc && o.sal[cc] != null) ? o.sal[cc] : null; }
      function curOf(side) { var cc = selCC[side]; return (cc && CTRY[cc]) ? CTRY[cc].cur : 'USD'; }

      // 按所选职业填充国家下拉；无薪资国家则隐藏该行
      function fillCountry(side) {
        var o = sel[side];
        var row = document.querySelector('.cb-country-row[data-side="' + side + '"]');
        var selEl = row.querySelector('.cb-country');
        var keys = ccKeys(o);
        selEl.innerHTML = '';
        keys.forEach(function (cc) {
          var op = document.createElement('option');
          op.value = cc; op.textContent = (CTRY[cc] ? CTRY[cc].name : cc);
          if (cc === selCC[side]) op.selected = true;
          selEl.appendChild(op);
        });
        row.hidden = keys.length < 1;
      }

      function paint(side) {
        var o = sel[side];
        var input = document.querySelector('.combobox[data-side="' + side + '"] .cb-input');
        if (o) input.value = o.n;
        var cat = document.querySelector('.cat-tag[data-side="' + side + '"]');
        cat.textContent = o ? o.c : '';
        var bd = document.querySelector('[data-side="' + side + '-badge"]');
        var b = band(o && o.e);
        bd.className = 'risk-badge ' + b.cls;
        bd.textContent = (o && o.e != null ? o.e + ' · ' : '') + b.label;
        var pay = salOf(side), cur = curOf(side);
        document.querySelector('[data-side="' + side + '-salary"]').textContent = fmtMoney(pay, cur);
        document.querySelector('[data-side="' + side + '-exp"]').textContent = o && o.e != null ? o.e : '—';
        document.querySelector('[data-side="' + side + '-pay"]').textContent = fmtMoney(pay, cur);
      }
      function notes() {
        var en = document.querySelector('[data-side="exp-note"]');
        var ae = sel.a && sel.a.e, be = sel.b && sel.b.e;
        if (sel.a && sel.b && ae != null && be != null)
          en.textContent = ae === be ? 'Equal exposure' : 'Higher for ' + (ae > be ? sel.a.n : sel.b.n);
        else en.textContent = '';
        var pn = document.querySelector('[data-side="pay-note"]');
        var ap = salOf('a'), bp = salOf('b');
        if (ap != null && bp != null && ap !== bp) {
          var hiN = ap > bp ? sel.a.n : sel.b.n, hi = Math.max(ap, bp), lo = Math.min(ap, bp);
          var diff = lo ? Math.round((hi - lo) / lo * 100) : 0;
          pn.textContent = hiN + (diff ? ' pays +' + diff + '%' : ' pays more');
        } else pn.textContent = '';
      }
      function go() {
        var link = document.getElementById('cmp-go');
        if (sel.a && sel.b && sel.a.s !== sel.b.s) {
          link.href = comparePrefix + sel.a.s + '-vs-' + sel.b.s;
          link.classList.remove('disabled');
        } else { link.href = '#'; link.classList.add('disabled'); }
      }
      function refresh() { fillCountry('a'); fillCountry('b'); paint('a'); paint('b'); notes(); go(); }

      // 国家下拉切换：只更新该侧薪资
      ['a', 'b'].forEach(function (side) {
        var row = document.querySelector('.cb-country-row[data-side="' + side + '"]');
        row.querySelector('.cb-country').addEventListener('change', function () {
          selCC[side] = this.value; paint(side); notes();
        });
      });

      // 可搜索下拉
      function wire(side) {
        var box = document.querySelector('.combobox[data-side="' + side + '"]');
        var input = box.querySelector('.cb-input');
        var list = box.querySelector('.cb-list');
        function render(q) {
          q = q.trim().toLowerCase();
          var items = (q ? OCCS.filter(function (o) { return o.n.toLowerCase().indexOf(q) !== -1; }) : OCCS).slice(0, 30);
          list.innerHTML = '';
          items.forEach(function (o) {
            var li = document.createElement('li');
            li.setAttribute('role', 'option');
            li.textContent = o.n;
            li.addEventListener('mousedown', function (e) {
              e.preventDefault();
              sel[side] = o; selCC[side] = firstCC(o); list.hidden = true; input.setAttribute('aria-expanded', 'false'); refresh();
            });
            list.appendChild(li);
          });
          list.hidden = items.length === 0;
          input.setAttribute('aria-expanded', items.length ? 'true' : 'false');
        }
        input.addEventListener('focus', function () { input.select(); render(''); });
        input.addEventListener('input', function () { render(input.value); });
        input.addEventListener('blur', function () { setTimeout(function () { list.hidden = true; if (sel[side]) input.value = sel[side].n; }, 120); });
      }
      wire('a'); wire('b');
      document.getElementById('cmp-swap').addEventListener('click', function () {
        var t = sel.a; sel.a = sel.b; sel.b = t;
        var tc = selCC.a; selCC.a = selCC.b; selCC.b = tc;
        refresh();
      });
      refresh();
    })();
  </script>

  <style>
    .cmp-hub { padding-bottom: 20px; }
    .hero { padding: 44px 0 24px; }
    .hero h1 { font-size: clamp(1.9rem, 4vw, 2.5rem); margin: 0 0 10px; letter-spacing: -0.02em; }
    .subhead { color: var(--text-muted); max-width: 680px; margin: 0 0 26px; font-size: 1.05rem; }

    .selectors { display: flex; gap: 20px; align-items: stretch; flex-wrap: wrap; }
    .selector-card { flex: 1 1 300px; background: var(--surface); border: 1px solid var(--line);
      border-radius: 20px; box-shadow: var(--shadow); padding: 20px; display: flex; flex-direction: column; gap: 12px; }
    .selector-label { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--text-muted); }
    .combobox { position: relative; }
    .cb-input { width: 100%; padding: 12px 16px; background: var(--bg); border: 1px solid var(--line);
      border-radius: 10px; font: inherit; font-size: 1rem; color: var(--text); outline: none; }
    .cb-input:focus { border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-tint); }
    .cb-list { position: absolute; z-index: 12; left: 0; right: 0; top: calc(100% + 4px); margin: 0; padding: 4px;
      list-style: none; background: var(--surface); border: 1px solid var(--line); border-radius: 10px;
      box-shadow: 0 12px 30px rgba(11,26,46,.16); max-height: 300px; overflow-y: auto; }
    .cb-list li { padding: 9px 12px; border-radius: 7px; cursor: pointer; font-size: 0.92rem; color: var(--text-body); }
    .cb-list li:hover { background: var(--surface-tint-2); color: var(--brand); }
    .cb-country-row { display: flex; align-items: center; gap: 8px; background: var(--bg);
      border: 1px solid var(--line); border-radius: 10px; padding: 8px 12px; }
    .cb-country-row i { color: var(--text-muted); font-size: 0.85rem; }
    .cb-country { flex: 1; border: none; background: transparent; font: inherit; font-size: 0.9rem;
      color: var(--text-strong); font-weight: 500; cursor: pointer; outline: none; }
    .cat-tag { font-size: 0.75rem; color: var(--text-muted); background: var(--surface-tint-2);
      align-self: flex-start; padding: 3px 12px; border-radius: 40px; }
    .cat-tag:empty { display: none; }
    .preview-line { display: flex; justify-content: space-between; align-items: center; gap: 10px;
      border-top: 1px solid var(--line); padding-top: 12px; margin-top: auto; font-size: 0.9rem; }
    .pv-salary { font-weight: 600; color: var(--text-strong); }

    .vs-divider { display: flex; align-items: center; justify-content: center; flex: none; }
    .vs-circle { width: 46px; height: 46px; border-radius: 50%; background: var(--surface-tint-2);
      border: 1px solid var(--line); color: var(--brand); cursor: pointer; font-size: 1rem;
      display: flex; align-items: center; justify-content: center; }
    .vs-circle:hover { background: var(--brand); color: #fff; border-color: var(--brand); }

    .cta-row { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; margin: 24px 0 20px; }
    .btn.primary.disabled { opacity: .5; pointer-events: none; }
    .small { font-size: 0.85rem; }

    .metric-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px;
      background: var(--surface); border: 1px solid var(--line); border-radius: 18px; padding: 20px; box-shadow: var(--shadow); }
    .metric-tile { padding: 14px 16px; border-radius: 12px; background: var(--bg); display: flex; flex-direction: column; gap: 6px; }
    .mt-label { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--text-muted); }
    .mt-cmp { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
    .mt-val { font-weight: 700; font-size: 1.2rem; }
    .mt-val.a { color: var(--brand); } .mt-val.b { color: var(--text-strong); }
    .mt-sep { color: var(--text-muted); font-weight: 400; font-size: 0.85rem; }
    .mt-note { font-size: 0.76rem; color: var(--text-muted); }

    .popular-section { margin: 40px 0 8px; }
    .popular-section h2, .faq-section h2 { font-size: 1.4rem; margin: 0 0 16px; }
    .popular-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; }
    .popular-card { background: var(--surface); border: 1px solid var(--line); border-radius: 14px;
      padding: 14px 18px; box-shadow: var(--shadow); color: var(--text); display: flex; flex-direction: column; gap: 6px; transition: .12s; }
    .popular-card:hover { transform: translateY(-2px); border-color: var(--brand); }
    .popular-card .pair { font-weight: 600; font-size: 0.92rem; color: var(--text-strong); }
    .popular-card .pv { color: var(--text-muted); font-weight: 400; font-size: 0.8rem; }
    .pair-stat { font-size: 0.8rem; color: var(--text-muted); }
    .pair-stat b { font-weight: 700; }
    .pair-stat b.high, .pair-stat b.critical { color: var(--risk-high); }
    .pair-stat b.moderate { color: var(--risk-mid-fg); }
    .pair-stat b.low, .pair-stat b.verylow { color: var(--risk-low); }

    .faq-section { margin: 40px 0 20px; }
    .faq-list { display: flex; flex-direction: column; gap: 12px; }
    .faq-item { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; box-shadow: var(--shadow); }
    .faq-item summary { list-style: none; cursor: pointer; padding: 15px 18px; font-weight: 600; color: var(--text);
      display: flex; justify-content: space-between; align-items: center; gap: 12px; }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item summary i { color: var(--text-muted); font-size: 0.8rem; transition: transform .2s; }
    .faq-item[open] summary i { transform: rotate(180deg); }
    .faq-answer { padding: 0 18px 16px; color: var(--text-body); font-size: 0.92rem; line-height: 1.7; }

    @media (max-width: 700px) { .selectors { flex-direction: column; } }
  </style>
</Base>
