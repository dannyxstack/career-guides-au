---
import Base from '../layouts/Base.astro';
import { JOB_SLUGS, jobBySlug, name as occName, countryName, COUNTRY_FLAG } from '../lib/data';
import { categoryIcon } from '../lib/industries';
import { pageLocale, contentLocale, hrefJob, hrefSearch } from '../lib/i18n';
import { expBand } from '../lib/ui';

const loc = pageLocale(Astro);
const CL = contentLocale(loc);
const q = (Astro.url.searchParams.get('q') || '').trim();
const ql = q.toLowerCase();

// 全球职业（按 slug 去重）；按名称匹配。空查询显示暴露最高的一批作为浏览入口。
const globals = JOB_SLUGS.map((s) => jobBySlug(s)!).filter(Boolean);
let results = globals;
if (ql) {
  results = globals.filter((g) => occName(g.rep, CL).toLowerCase().includes(ql));
}
results = results
  .map((g) => ({
    slug: g.slug, name: occName(g.rep, CL), cat: g.rep.category,
    aioe: g.rep.ai?.aioe_pct ?? null,
    countries: g.countries.map((o) => o.country),
    work: g.countries.reduce((s, o) => s + (o.workforce_size || 0), 0),
  }))
  .sort((a, b) => (ql ? a.name.length - b.name.length : b.work - a.work))
  .slice(0, 60);
---
<Base title={q ? `Search: ${q} | AI Job Risk` : 'Browse occupations | AI Job Risk'} description="Search occupations and check AI replacement risk." active="occupations">
  <div class="container search-page">
    <h1>{q ? `Results for “${q}”` : 'Browse occupations'}</h1>
    <form class="search-box" action={hrefSearch(loc)} method="get" role="search">
      <input type="text" name="q" value={q} placeholder="Search a job, e.g. “Accountant”…" aria-label="Search occupations" autofocus />
      <button type="submit"><i class="fas fa-search"></i> Search</button>
    </form>
    <p class="muted count">{results.length}{results.length === 60 ? '+' : ''} occupations{q ? ` matching “${q}”` : ' by workforce'}</p>

    {results.length === 0 ? (
      <p class="card muted">No occupations found. Try a different term.</p>
    ) : (
      <div class="res-grid">
        {results.map((r) => {
          const b = r.aioe != null ? expBand(r.aioe) : null;
          return (
            <a class="res-card" href={hrefJob(loc, r.slug)}>
              <div class="rc-name">{r.name}</div>
              <div class="rc-cat"><i class={`fas ${categoryIcon(r.cat)}`}></i> {r.cat}</div>
              <div class="rc-foot">
                {b && <span class={`risk-badge ${b.cls}`}>AI exposure {r.aioe} · {b.label}</span>}
                <span class="rc-flags">{r.countries.slice(0, 6).map((cc) => (
                  <span class="flag" title={countryName(cc, CL)} set:html={COUNTRY_FLAG[cc]} />
                ))}</span>
              </div>
            </a>
          );
        })}
      </div>
    )}
  </div>

  <style>
    .search-page { padding: 32px 0 20px; }
    .search-page h1 { font-size: 1.9rem; margin: 0 0 18px; }
    .search-box { max-width: 620px; display: flex; background: var(--surface); border-radius: 60px;
      box-shadow: 0 8px 24px rgba(37,99,235,.1); border: 1px solid var(--line); overflow: hidden; }
    .rc-cat i { margin-right: 4px; }
    .search-box input { flex: 1; border: none; padding: 14px 22px; font-size: 1rem; outline: none; color: var(--text); }
    .search-box button { background: var(--brand); border: none; color: #fff; padding: 0 28px; font-weight: 600; cursor: pointer; white-space: nowrap; }
    .search-box button:hover { background: var(--brand-hover); }
    .count { margin: 14px 0 18px; font-size: 0.9rem; }
    .res-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; padding-bottom: 24px; }
    .res-card { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 16px 18px; box-shadow: var(--shadow); color: var(--text); transition: .12s; }
    .res-card:hover { border-color: var(--brand); transform: translateY(-2px); }
    .rc-name { font-weight: 600; font-size: 1rem; }
    .rc-cat { font-size: 0.8rem; color: var(--text-muted); margin: 2px 0 12px; }
    .rc-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
    .rc-flags { display: inline-flex; gap: 3px; }
    .rc-flags .flagsvg { width: 18px; height: 12px; border-radius: 2px; box-shadow: 0 0 0 1px var(--line); display: block; }
  </style>
</Base>
