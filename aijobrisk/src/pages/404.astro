---
import Base from '../layouts/Base.astro';
import { pageLocale, contentLocale, withL } from '../lib/i18n';
import { tr } from '../lib/data';
const loc = pageLocale(Astro);
const CL = contentLocale(loc);
---
<Base title={`${tr('Not found', CL)} — AI Job Risk`} description={tr('Page not found.', CL)}>
  <div class="container nf">
    <h1>404</h1>
    <p class="muted">{tr('That page could not be found.', CL)}</p>
    <div class="acts">
      <a class="btn primary" href={withL(loc, '/')}>{tr('Home', CL)}</a>
      <a class="btn" href={withL(loc, '/search')}>{tr('Browse occupations', CL)}</a>
      <a class="btn" href={withL(loc, '/rankings')}>{tr('Rankings', CL)}</a>
    </div>
  </div>
  <style>
    .nf { text-align: center; padding: 80px 0; }
    .nf h1 { font-size: 4rem; margin: 0; color: var(--brand); }
    .acts { display: flex; gap: 12px; justify-content: center; margin-top: 24px; flex-wrap: wrap; }
  </style>
</Base>
